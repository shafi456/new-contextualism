---
/**
 * One of the ten contextual layers (1.6): its definition, the founder's terms,
 * research questions, an analytical diagram, its relations with the other
 * layers, and the records and projects that foreground it.
 */
import type { GetStaticPaths } from 'astro';
import SectionPage from '../../../layouts/SectionPage.astro';
import Provenance from '../../../components/Provenance.astro';
import Plate from '../../../components/Plate.astro';
import ContextDiagram from '../../../components/ContextDiagram.astro';
import RecordList from '../../../components/RecordList.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { citations, projectsForDimension, recordsForDimension, registry, relationsFor } from '../../../lib/content';
import { dimensionMedia } from '../../../lib/media';
import { isPublic } from '../../../lib/visibility';
import { pad } from '../../../lib/format';
import { to } from '../../../lib/routes';

export const getStaticPaths = (async () => {
  const reg = await registry();
  return reg.dimensions.filter((d) => isPublic(`/philosophy/layers/${d.id}/`)).map((d) => ({ params: { id: d.id } }));
}) satisfies GetStaticPaths;

const reg = await registry();
const { id } = Astro.params;
const dim = reg.dimension.get(id!)!;
const d = dim.data;
const index = reg.dimensions.indexOf(dim);
const N = reg.dimensions.length;
const prev = reg.dimensions[(index - 1 + N) % N];
const next = reg.dimensions[(index + 1) % N];

const cite = citations(reg, `layers/${id}`);
const definition = cite.md(dim.body);
cite.add(d.keywordsSource);
const rels = relationsFor(dim.id).map((r) => {
  if (r.source) cite.add(r.source);
  return { ...r, dim: reg.dimension.get(r.other)! };
});
const records = recordsForDimension(reg, dim.id);
const projects = projectsForDimension(reg, dim.id);
const media = dimensionMedia(dim);
const name = d.name;
const layerLinks = reg.dimensions.map((x) => ({ href: to.layer(x.id), label: x.data.name, current: x.id === dim.id }));
const pager = {
  prev: { href: to.layer(prev.id), label: `Layer ${pad(prev.data.number)}`, name: prev.data.name },
  next: { href: to.layer(next.id), label: `Layer ${pad(next.data.number)}`, name: next.data.name },
};
---

<SectionPage
  path="/philosophy/layers/"
  reg={reg}
  title={name}
  label={`Layer ${pad(d.number)} of ${pad(N)} · The Ten Contextual Layers`}
  crumb={name}
  intro={d.summary}
  description={`${d.summary} The ${name.toLowerCase()} layer of New Contextualism.`}
  provenance={d.provenance}
  approval={d.approval}
  cited={cite.cited()}
  subnav={layerLinks}
  pager={pager}
>
  <section class="layer-section" aria-labelledby="definition-title">
    <h2 class="layer-section__title" id="definition-title">Definition</h2>
    <div class="prose page-prose layer__prose" set:html={definition} />
    <div class="layer__aside">
      <div class="terms">
        <p class="label">In the founder’s terms</p>
        <p class="terms__words">{d.keywords.join(', ')}</p>
        <p class="small muted">
          As published in <a href={`#ref-${d.keywordsSource}`}>{cite.label(d.keywordsSource)}</a>
        </p>
      </div>
      <div class="questions">
        <p class="label">Key research questions</p>
        <ol role="list">
          {
            d.questions.map((q, i) => (
              <li>
                <span class="questions__num">{pad(i + 1)}</span>
                <span>{q}</span>
              </li>
            ))
          }
        </ol>
        <Provenance kind="editorial-summary" approval={d.approval} note="Questions proposed by the editors" />
      </div>
    </div>
  </section>

  <section class="layer-section" aria-labelledby="diagram-title">
    <h2 class="layer-section__title" id="diagram-title">Analytical diagram</h2>
    <Plate
      src={media.src}
      alt={media.alt}
      width={media.width}
      height={media.height}
      ratio="4 / 3"
      tag={media.tag}
      caption={media.caption}
      class="layer__plate"
    />
  </section>

  <section class="layer-section" aria-labelledby="connections-title">
    <h2 class="layer-section__title" id="connections-title">{name} in relation</h2>
    <div class="connections">
      <div class="connections__diagram">
        <ContextDiagram reg={reg} mode="static" selected={dim.id} />
      </div>
      <div class="connections__list">
        <Provenance kind="interpretation" note="Relations proposed by the editors" />
        <ul role="list">
          {
            rels.map((r) => (
              <li>
                <a class="connections__name" href={to.layer(r.other)}>
                  <span class="label">{pad(r.dim.data.number)}</span>{' '}{r.dim.data.name}
                </a>
                <p class="connections__note">
                  {r.note}
                  {r.source && (
                    <>
                      {' '}
                      <span class="muted small">
                        Example drawn from <a href={`#ref-${r.source}`}>{cite.label(r.source)}</a>.
                      </span>
                    </>
                  )}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="layer-section" aria-labelledby="records-title">
    <h2 class="layer-section__title" id="records-title">Relevant publications</h2>
    {
      records.length ? (
        <RecordList reg={reg} records={records} compact />
      ) : (
        <p class="pending">
          <span class="label">No records yet</span>
          No archive records have yet been tagged with this layer.
        </p>
      )
    }
    <p class="layer__more">
      <a class="arrow-link arrow-link--quiet" href={to.archive({ layer: dim.id })}>
        Filter the archive by this layer <span class="arrow" aria-hidden="true">→</span>
      </a>
    </p>
  </section>

  <section class="layer-section" aria-labelledby="projects-title">
    <h2 class="layer-section__title" id="projects-title">Related projects</h2>
    {
      projects.length ? (
        <div class="layer__projects">
          {projects.map((p) => (
            <ProjectCard project={p} dimensions={reg.dimensions} sizes="(min-width: 900px) 30vw, 100vw" />
          ))}
        </div>
      ) : (
        <p class="pending">
          <span class="label">No projects yet</span>
          No documented project foregrounds this layer.
        </p>
      )
    }
  </section>
</SectionPage>

<style>
  .layer-section + .layer-section {
    margin-top: clamp(3.5rem, 3rem + 2.5vw, 6rem);
  }

  .layer-section__title {
    margin-bottom: 1.75rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--ink);
    font-size: clamp(2rem, 1.5rem + 1.6vw, 3rem);
    line-height: 1.04;
  }

  .layer__prose :global(p:first-child) {
    font-family: var(--serif);
    font-size: clamp(1.3rem, 1.15rem + 0.55vw, 1.6rem);
    line-height: 1.3;
  }

  .layer__aside {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem var(--col-gap);
    margin-top: 3rem;
  }

  .terms {
    padding: 1.25rem 0 1.4rem;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    align-self: start;
  }

  .terms__words {
    margin: 0.6rem 0 0.5rem;
    font-family: var(--serif);
    font-size: 1.75rem;
    line-height: 1.15;
  }

  .questions ol {
    margin: 0.75rem 0 1.25rem;
  }

  .questions li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    padding: 0.65rem 0;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .questions__num {
    font-size: 0.75rem;
    color: var(--ink-2);
    padding-top: 0.2em;
  }

  :global(.layer__plate) {
    max-width: 52rem;
  }

  .connections {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem var(--col-gap);
    align-items: start;
  }

  .connections__list {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .connections__list ul {
    margin: 0;
  }

  .connections__list li {
    padding: 0.9rem 0;
    border-top: 1px solid var(--rule);
  }

  .connections__name {
    font-family: var(--serif);
    font-size: 1.5rem;
    text-decoration: none;
  }

  .connections__name:hover {
    color: var(--brick);
  }

  .connections__note {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .layer__more {
    margin-top: 1.5rem;
  }

  .layer__projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3.5rem var(--col-gap);
  }

  @media (max-width: 1280px) {
    .connections {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .layer__aside,
    .layer__projects {
      grid-template-columns: 1fr;
    }
  }
</style>
