---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Provenance from '../components/Provenance.astro';
import { renderMarkdown } from '../lib/markdown';
import { slugify } from '../lib/format';
import { settings } from '../lib/site';

const page = await getEntry('pages', 'contact');
const body = renderMarkdown(page?.body, { label: (k) => k });
const email = settings.contactEmail;
const enquiries = [
  { title: 'Research contributions', text: 'Proposals for research, case studies, critical responses or project documentation.' },
  { title: 'Academic collaborations', text: 'Studios, theses and joint research testing the framework.' },
  { title: 'Lectures and events', text: 'Invitations, and proposals for lectures, seminars and workshops.' },
  { title: 'Corrections to the record', text: 'Errors of fact, citation or attribution anywhere on the platform.' },
  { title: 'Permissions and images', text: 'Photographs and drawings of projects, and permission to reproduce material.' },
  { title: 'General correspondence', text: 'Anything else about New Contextualism or this platform.' },
];
const mailto = (subject: string) => `mailto:${email}?subject=${encodeURIComponent(`New Contextualism: ${subject}`)}`;
---

<Base title="Contact" description="Correspondence about New Contextualism, this platform and its archive.">
  <PageHeader label={page?.data.label ?? 'Correspondence'} title="Contact" intro={page?.data.intro} compact />

  <section class="wrap contact">
    <div class="grid">
      <div class="contact__intro">
        <div class="prose" set:html={body} />
        <Provenance kind={page?.data.provenance ?? 'proposed'} approval={page?.data.approval} />
      </div>
      <div class="contact__main">
        {
          email ? (
            <>
              <p class="label">Write to the editors</p>
              <ul class="enquiries" role="list">
                {enquiries.map((e) => (
                  <li id={slugify(e.title)}>
                    <a href={mailto(e.title)}>
                      <span class="enquiries__title">{e.title}</span>
                      <span class="enquiries__text">{e.text}</span>
                      <span class="enquiries__arrow" aria-hidden="true">
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <p class="small muted">
                Each link opens a message to <a href={`mailto:${email}`}>{email}</a> in your email application.
              </p>
            </>
          ) : (
            <>
              <div class="pending">
                <span class="label">Address not yet published</span>
                The correspondence address for this platform has not yet been confirmed. It will appear here, with links for each
                kind of enquiry, once it has been set in the site settings.
              </div>
              <p class="label contact__while">In the meantime</p>
              <p>
                The founder’s institutional profile, with his published contact details, is available from{' '}
                <a class="ext" href="https://www.bracu.ac.bd/node/1077">
                  BRAC University
                </a>
                .
              </p>
              <ul class="enquiries enquiries--static" role="list">
                {enquiries.map((e) => (
                  <li id={slugify(e.title)}>
                    <span class="enquiries__title">{e.title}</span>
                    <span class="enquiries__text">{e.text}</span>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .contact__intro {
    grid-column: 1 / span 5;
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .contact__main {
    grid-column: 7 / span 6;
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .contact__while {
    margin-top: 1.5rem;
  }

  .enquiries {
    margin: 0.5rem 0 0;
    border-top: 1px solid var(--ink);
  }

  .enquiries li {
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .enquiries a,
  .enquiries--static li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2rem;
    gap: 0.25rem 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .enquiries__title {
    font-family: var(--serif);
    font-size: 1.5rem;
    line-height: 1.15;
  }

  .enquiries__text {
    grid-column: 1;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .enquiries__arrow {
    grid-row: 1;
    grid-column: 2;
    justify-self: end;
  }

  .enquiries a:hover .enquiries__title {
    color: var(--brick);
  }

  .enquiries li:target {
    background: linear-gradient(90deg, color-mix(in srgb, var(--sage) 35%, transparent), transparent 80%);
  }

  @media (max-width: 900px) {
    .contact__intro,
    .contact__main {
      grid-column: 1 / -1;
    }

    .contact__main {
      margin-top: 2.5rem;
    }
  }
</style>
