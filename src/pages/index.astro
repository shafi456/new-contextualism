---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Plate from '../components/Plate.astro';
import Provenance from '../components/Provenance.astro';
import Quote from '../components/Quote.astro';
import DimensionGrid from '../components/DimensionGrid.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RecordList from '../components/RecordList.astro';
import { archiveRecords, eventIsUpcoming, founder, listed, registry } from '../lib/content';
import { HERO_PLATE } from '../lib/media';
import { settings } from '../lib/site';
import { STATUS_LABELS } from '../lib/provenance';
import { pubYear } from '../lib/cite';
import { url } from '../lib/url';

const reg = await registry();
const dims = reg.dimensions;
const projects = listed(reg.projects);
const featured = projects.filter((p) => p.data.featured).slice(0, 4);
const counts = (['completed', 'ongoing', 'conceptual'] as const).map((s) => ({
  status: s,
  n: projects.filter((p) => p.data.status === s).length,
}));
const person = founder(reg);
const nc = archiveRecords(reg).filter((p) => p.data.collection === 'new-contextualism');
const selected = nc.filter((p) => p.data.type !== 'lecture').slice(0, 5);
const allRecords = archiveRecords(reg);
const years = allRecords.map((p) => pubYear(p) ?? 0).filter(Boolean);
const types = new Set(allRecords.map((p) => p.data.type));
const upcoming = reg.events.filter((e) => eventIsUpcoming(e));
const lastEvent = reg.events.find((e) => !eventIsUpcoming(e));

const label = (k: string) => reg.labels.get(k) ?? k;
const rec = (k: string) => url(`/research/${k}/`);

const community = [
  {
    title: 'Research contributions',
    text: 'Propose research, case studies or critical responses for the archive.',
    href: url('/dialogue/#contributions'),
  },
  {
    title: 'Academic collaborations',
    text: 'Studios, theses and joint research that test the framework.',
    href: url('/dialogue/#collaborations'),
  },
  {
    title: 'Lectures and seminars',
    text: 'Talks on New Contextualism, past and forthcoming.',
    href: url('/dialogue/#lectures'),
  },
  {
    title: 'Calls for papers',
    text: 'There are no open calls at present.',
    href: url('/dialogue/#calls'),
  },
  {
    title: 'Workshops and events',
    text: upcoming.length
      ? `${upcoming.length} forthcoming event${upcoming.length === 1 ? '' : 's'}.`
      : lastEvent
        ? `No events are scheduled. The most recent was in ${lastEvent.data.start.getUTCFullYear()}.`
        : 'No events are scheduled.',
    href: url('/dialogue/#events'),
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: settings.title,
  description: settings.description,
  inLanguage: 'en-GB',
};
---

<Base jsonLd={jsonLd}>
  <!-- B. Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero__meta">
        <p class="label">Architecture · Urbanism · Philosophy</p>
        <p class="label hero__origin">
          Originated by <a href={url('/about/#founder')}>Mohammad Habib Reza</a>
        </p>
      </div>
      <h1 class="hero__title" id="hero-title">
        <span>New</span>
        <span>Contextualism</span>
      </h1>
      <div class="grid hero__intro">
        <p class="hero__tagline" data-approved={settings.taglineApproved ? 'true' : 'false'}>
          {settings.tagline.split('. ').map((line, i, all) => (i < all.length - 1 ? <span>{line}.</span> : <span>{line}</span>))}
        </p>
        <div class="hero__text">
          <p>{settings.description}</p>
          <p class="hero__links">
            <a class="arrow-link" href={url('/philosophy/')}>Explore the Philosophy <span class="arrow" aria-hidden="true">↗</span></a>
            <a class="arrow-link" href={url('/research/')}>Discover the Research <span class="arrow" aria-hidden="true">↗</span></a>
          </p>
        </div>
      </div>
      <Plate
        class="hero__plate"
        src={HERO_PLATE.src}
        alt={HERO_PLATE.alt}
        width={HERO_PLATE.width}
        height={HERO_PLATE.height}
        number="Plate I"
        caption={HERO_PLATE.caption}
        eager
        reveal={false}
        sizes="100vw"
      />
    </div>
  </section>

  <!-- C. The idea -->
  <section class="section idea" aria-labelledby="idea-title">
    <div class="wrap">
      <SectionHead index="01" label="The Idea" />
      <div class="grid">
        <h2 class="idea__title" id="idea-title" data-reveal>Context is more than what surrounds us.</h2>
        <div class="idea__text" data-reveal>
          <p class="lede">
            Every place is shaped by visible and invisible forces. Histories, social relationships, cultural practices, ecological
            processes, political structures, and everyday life contribute to the meaning of the built environment.
          </p>
          <p>
            New Contextualism approaches architecture and urbanism through these interconnected conditions, seeking a deeper
            understanding of place and the possibilities for meaningful transformation.
          </p>
          <Provenance kind="editorial-summary" approval="pending" />
          <Quote
            class="idea__quote"
            text="Context, in the New Contextualist framework, transcends the immediate physical site."
            author="Mohammad Habib Reza"
            source="The Daily Star"
            label={label('reza-2025-deltaic-bangladesh')}
            href={rec('reza-2025-deltaic-bangladesh')}
          />
          <a class="arrow-link" href={url('/philosophy/')}>Read the philosophy <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- D. The framework -->
  <section class="section framework" aria-labelledby="framework-title">
    <div class="wrap">
      <SectionHead index="02" label="The Framework" />
      <div class="grid framework__head">
        <h2 class="framework__title" id="framework-title" data-reveal>Ten dimensions. Interconnected realities.</h2>
        <div class="framework__intro" data-reveal>
          <p>
            The founder’s writing describes context as a ‘tenfold matrix’ of overlapping dimensions. None is read alone: each is
            entangled with the others, and every project weighs them differently.
          </p>
          <p class="small muted">
            Dimensions and their terms from <a href={rec('reza-2025-deltaic-bangladesh')}>{label('reza-2025-deltaic-bangladesh')}</a>.
            The relations traced here are an editorial interpretation.
          </p>
        </div>
      </div>
      <DimensionGrid dimensions={dims} />
      <p class="framework__more">
        <a class="arrow-link" href={url('/framework/')}>Explore the contextual diagram <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- E. In practice -->
  <section class="section practice" aria-labelledby="practice-title">
    <div class="wrap">
      <SectionHead index="03" label="In Practice" />
      <div class="grid practice__head">
        <h2 class="practice__title" id="practice-title" data-reveal>Thinking through places.</h2>
        <div class="practice__intro" data-reveal>
          <p>
            Theses, studio projects and competition entries in which the framework has been applied, documented from published
            sources. The drawings that accompany them are abstract editorial plates, not drawings of the projects.
          </p>
          <ul class="practice__counts" role="list">
            {
              counts.map((c) => (
                <li>
                  <span class={`status status--${c.status}`}>{STATUS_LABELS[c.status]}</span>
                  <span class="num">{c.n}</span>
                </li>
              ))
            }
          </ul>
          <p class="small muted">No built works have yet been documented on this platform.</p>
        </div>
      </div>
      <div class="grid practice__gallery">
        {
          featured.map((p, i) => (
            <div class={`practice__item practice__item--${i}`} data-reveal>
              <ProjectCard
                project={p}
                dimensions={dims}
                ratio={i === 3 ? '16 / 10' : '4 / 3'}
                sizes={i === 0 || i === 3 ? '(min-width: 900px) 55vw, 100vw' : '(min-width: 900px) 35vw, 100vw'}
              />
            </div>
          ))
        }
      </div>
      <p class="practice__more">
        <a class="arrow-link" href={url('/projects/')}>All projects and research <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- F. The origin -->
  <section class="section origin" aria-labelledby="origin-title">
    <div class="wrap">
      <SectionHead index="04" label="The Origin" />
      <div class="grid">
        <div class="origin__portrait" data-reveal>
          <div class="portrait-slot" role="img" aria-label="Placeholder: an approved portrait of the founder has not yet been supplied">
            <span class="label">Portrait</span>
            <span class="portrait-slot__note">An approved photograph of the founder will appear here.</span>
          </div>
        </div>
        <div class="origin__text">
          <h2 class="origin__title" id="origin-title" data-reveal>An evolving architectural philosophy.</h2>
          <div class="origin__body" data-reveal>
            <p class="lede">
              New Contextualism was originated by Mohammad Habib Reza, an architect, architectural historian and Associate Professor
              at the School of Architecture and Design, BRAC University, Dhaka.
            </p>
            <p>
              In his account, the approach grew from early work as an architect-planner for the Barisal City Corporation and from
              doctoral research on the early Buddhist architecture of Bengal, and has been developed over more than a decade in
              teaching at BRAC University (<a href={rec('reza-2023-new-contextualism-path')}>{label('reza-2023-new-contextualism-path')}</a>;
              <a href={rec('reza-2025-deltaic-bangladesh')}>{label('reza-2025-deltaic-bangladesh')}</a>).
            </p>
            <Provenance kind={person?.data.provenance ?? 'editorial-summary'} approval="pending" note="Compiled from published sources" />
            <div class="origin__works">
              <p class="label">Selected writing and lectures</p>
              <ul role="list">
                {
                  ['reza-nitu-2025-people-place-justice', 'reza-2025-deltaic-bangladesh', 'reza-2023-new-contextualism-path', 'reza-2023-introduction-lecture']
                    .map((k) => reg.publication.get(k))
                    .filter(Boolean)
                    .map((p) => (
                      <li>
                        <a href={rec(p!.id)}>{p!.data.title}</a>
                        <span class="muted small">
                          {' '}
                          {p!.data.type === 'lecture' ? 'Lecture, BRAC University' : p!.data.venue}, {pubYear(p!)}
                        </span>
                      </li>
                    ))
                }
              </ul>
            </div>
            <p class="origin__links">
              <a class="arrow-link" href={url('/movement/#origins')}>Explore the Movement’s Origins <span class="arrow" aria-hidden="true">↗</span></a>
              <a class="arrow-link arrow-link--quiet" href={url('/about/#founder')}>Founder’s profile <span class="arrow" aria-hidden="true">→</span></a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- G. The archive -->
  <section class="section archive" aria-labelledby="archive-title">
    <div class="wrap">
      <SectionHead index="05" label="The Archive" />
      <div class="grid archive__head">
        <h2 class="archive__title" id="archive-title" data-reveal>An ongoing conversation.</h2>
        <div class="archive__intro" data-reveal>
          <p>
            Essays, lectures and reports that make up the published record of New Contextualism, alongside the founder’s earlier
            scholarship. Every record has a persistent address and a full citation.
          </p>
          <p class="archive__stats label">
            {allRecords.length} records · {types.size} types · {Math.min(...years)}–{Math.max(...years)}
          </p>
        </div>
      </div>
      <div data-reveal>
        <RecordList reg={reg} records={selected} compact />
      </div>
      <p class="archive__more">
        <a class="arrow-link" href={url('/research/')}>Browse the full archive, with filters <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- H. The community -->
  <section class="section community" aria-labelledby="community-title">
    <div class="wrap">
      <SectionHead index="06" label="The Community" />
      <div class="grid">
        <h2 class="community__title" id="community-title" data-reveal>Context crosses disciplines.</h2>
        <div class="community__body" data-reveal>
          <p class="lede">
            New Contextualism has developed through design studios, workshops, lectures and symposia, and through exchange between
            practice and academia.
          </p>
          <p>
            This platform is intended as a place for that dialogue to continue, across disciplines and between local conditions and
            wider systems. It is not a membership organisation; the ways to take part are set out below.
          </p>
          <Provenance kind="proposed" approval="pending" />
        </div>
      </div>
      <ul class="community__links" role="list">
        {
          community.map((c) => (
            <li data-reveal>
              <a href={c.href}>
                <span class="community__name">{c.title}</span>
                <span class="community__text">{c.text}</span>
                <span class="community__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .hero__meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-bottom: clamp(1.5rem, 1rem + 2.5vw, 3.5rem);
  }

  .hero__origin a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }

  .hero__title {
    font-size: var(--fs-mast);
    line-height: 0.82;
    letter-spacing: -0.012em;
    text-transform: uppercase;
    margin-left: -0.04em;
  }

  .hero__title span {
    display: block;
  }

  .hero__intro {
    margin-top: clamp(2rem, 1.5rem + 2.5vw, 4rem);
    row-gap: 1.5rem;
    align-items: start;
  }

  .hero__tagline {
    grid-column: 1 / span 5;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem);
    line-height: 1.08;
  }

  .hero__tagline span {
    display: block;
  }

  .hero__text {
    grid-column: 7 / span 5;
    display: grid;
    gap: 1.5rem;
    font-size: 1.0625rem;
    max-width: 30rem;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  .hero__plate {
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .hero__plate :global(.plate__frame) {
    aspect-ratio: 2400 / 1100;
  }

  /* On small screens the plate is cropped to a taller frame so it stays legible. */
  @media (max-width: 640px) {
    .hero__plate :global(.plate__frame) {
      aspect-ratio: 4 / 3;
    }

    .hero__plate :global(img) {
      object-position: 62% 50%;
    }
  }

  /* The idea */
  .idea__title {
    grid-column: 1 / span 4;
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 3.75rem);
    line-height: 1.02;
  }

  .idea__text {
    grid-column: 6 / span 6;
    display: grid;
    gap: 1.5rem;
    max-width: 40rem;
  }

  .idea__quote {
    margin: 1.5rem 0 0.5rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--brick);
  }

  /* The framework */
  .framework__head,
  .practice__head,
  .archive__head {
    row-gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    align-items: end;
  }

  .framework__title,
  .practice__title,
  .archive__title,
  .community__title,
  .origin__title {
    grid-column: 1 / span 7;
  }

  .framework__intro,
  .practice__intro,
  .archive__intro {
    grid-column: 9 / span 4;
    display: grid;
    gap: 1rem;
  }

  .framework__more,
  .practice__more,
  .archive__more {
    margin-top: 2.5rem;
  }

  /* In practice */
  .practice__counts {
    display: grid;
    gap: 0.35rem;
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
  }

  .practice__counts li {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.35rem;
  }

  .practice__gallery {
    row-gap: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .practice__item--0 {
    grid-column: 1 / span 7;
  }

  .practice__item--1 {
    grid-column: 9 / span 4;
    margin-top: clamp(4rem, 10vw, 11rem);
  }

  .practice__item--2 {
    grid-column: 2 / span 4;
  }

  .practice__item--3 {
    grid-column: 7 / span 6;
    margin-top: clamp(2rem, 6vw, 7rem);
  }

  /* Origin */
  .origin__portrait {
    grid-column: 1 / span 4;
  }

  .portrait-slot {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 4 / 5;
    padding: 1rem;
    border: 1px solid var(--rule);
    background:
      linear-gradient(to top right, transparent calc(50% - 0.5px), var(--rule) 50%, transparent calc(50% + 0.5px)),
      var(--paper);
  }

  .portrait-slot__note {
    max-width: 14rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ink-2);
    background: var(--paper);
  }

  .origin__text {
    grid-column: 6 / span 7;
  }

  .origin__title {
    font-size: var(--fs-h2);
  }

  .origin__body {
    display: grid;
    gap: 1.4rem;
    max-width: 40rem;
    margin-top: clamp(1.75rem, 1rem + 2vw, 3rem);
  }

  .origin__works ul {
    margin: 0.6rem 0 0;
  }

  .origin__works li {
    padding: 0.6rem 0;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
  }

  .origin__works a {
    font-family: var(--serif);
    font-size: 1.15rem;
    text-decoration-color: var(--rule);
  }

  .origin__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  /* Archive */
  .archive__stats {
    color: var(--ink);
  }

  /* Community */
  .community__body {
    grid-column: 8 / span 5;
    display: grid;
    gap: 1.25rem;
    margin-top: 0.4rem;
  }

  .community__links {
    margin: clamp(2.5rem, 2rem + 3vw, 4.5rem) 0 0;
    border-top: 1px solid var(--ink);
  }

  .community__links a {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) 2rem;
    gap: 0.5rem var(--col-gap);
    align-items: baseline;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .community__name {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.125rem);
    line-height: 1.1;
    transition: color 0.3s var(--ease);
  }

  .community__text {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .community__arrow {
    justify-self: end;
    transition: transform 0.3s var(--ease);
  }

  .community__links a:hover .community__name {
    color: var(--brick);
  }

  .community__links a:hover .community__arrow {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .hero__tagline,
    .hero__text,
    .idea__title,
    .idea__text,
    .framework__title,
    .practice__title,
    .archive__title,
    .community__title,
    .origin__title,
    .framework__intro,
    .practice__intro,
    .archive__intro,
    .community__body,
    .origin__text,
    .practice__item--0,
    .practice__item--1,
    .practice__item--2,
    .practice__item--3 {
      grid-column: 1 / -1;
      margin-top: 0;
    }

    .idea__text {
      margin-top: 2rem;
    }

    .origin__portrait {
      grid-column: 1 / span 8;
      margin-bottom: 2.5rem;
    }

    .community__links a {
      grid-template-columns: 1fr 2rem;
    }

    .community__text {
      grid-column: 1;
    }

    .community__arrow {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>
