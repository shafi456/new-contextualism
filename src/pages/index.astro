---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Plate from '../components/Plate.astro';
import Provenance from '../components/Provenance.astro';
import Quote from '../components/Quote.astro';
import DimensionGrid from '../components/DimensionGrid.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RecordList from '../components/RecordList.astro';
import { archiveRecords, eventIsUpcoming, listed, registry } from '../lib/content';
import { HERO_PLATE } from '../lib/media';
import { settings } from '../lib/site';
import { HOME, sectionByKey } from '../lib/ia';
import { STATUS_LABELS } from '../lib/provenance';
import { pubYear } from '../lib/cite';
import { to } from '../lib/routes';
import { url } from '../lib/url';

const reg = await registry();
const dims = reg.dimensions;
const projects = listed(reg.projects);
const featured = projects.filter((p) => p.data.featured).slice(0, 4);
const counts = (['completed', 'ongoing', 'conceptual'] as const).map((s) => ({
  status: s,
  n: projects.filter((p) => p.data.status === s).length,
}));
const allRecords = archiveRecords(reg);
const latest = allRecords.slice(0, 5);
const years = allRecords.map((p) => pubYear(p) ?? 0).filter(Boolean);
const types = new Set(allRecords.map((p) => p.data.type));
const upcoming = reg.events.filter((e) => eventIsUpcoming(e));
const lastEvent = reg.events.find((e) => !eventIsUpcoming(e));

const label = (k: string) => reg.labels.get(k) ?? k;
const DS = 'reza-2025-deltaic-bangladesh';
const CBD = 'reza-nitu-2025-people-place-justice';
const head = (n: string) => HOME.pages.find((p) => p.number === n)!;
const philosophy = sectionByKey('philosophy');
const methodologies = sectionByKey('methodologies');

const steps = [
  { title: 'Read the core proposition', text: 'What New Contextualism is, why it was proposed and what it covers.', href: url('/philosophy/definition-and-scope/') },
  { title: 'Learn the ten layers', text: 'The ten contextual layers through which a place is read, each defined in the founder’s terms.', href: to.layers() },
  { title: 'Follow the method', text: 'How a project reads its context, then plans and develops a response.', href: url('/methodologies/read-plan-process/') },
  { title: 'See it applied', text: 'Theses, studio projects and proposals, documented from published sources.', href: url('/projects/') },
  { title: 'Go to the sources', text: 'Every claim links to a published record that you can read and cite.', href: url('/research/') },
];

// Each idea quotes the founder’s published wording, checked against the source.
const ideas = [
  { title: 'More than the site', quote: 'transcends the immediate physical site', text: 'Context includes social, cultural, ecological and political conditions, not only the surrounding buildings.', source: DS },
  { title: 'Ten overlapping layers', quote: 'a tenfold overlapping analysis', text: 'Places are read through ten layers at once, weighted differently in each project.', source: DS },
  { title: 'Past and future', quote: 'intrinsically forward-looking, yet profoundly anchored in an understanding of the past', text: 'History is the basis for anticipating the needs a building will meet.', source: DS },
  { title: 'The universal and the particular', quote: 'critical adaptation to the specificities of the local', text: 'Global knowledge is welcomed, but filtered through local climate, materials and culture.', source: DS },
  { title: 'A method, not a style', quote: 'process-based rather than style-based', text: 'What is new lies in a way of reading and weighing context, not in a recognisable form.', source: CBD },
  { title: 'Equity and justice', quote: 'must protect the “right to the city”', text: 'No project should strip away people’s access to space, belonging or shared resources.', source: CBD },
];

const phases = [
  { name: 'Read', text: 'Investigating context through the ten layers: the phase given particular weight.' },
  { name: 'Plan', text: 'Translating what is found into strategy.' },
  { name: 'Process', text: 'Developing, testing and refining the response.' },
];

const community = [
  { title: 'Community submissions', text: 'Propose research, case studies or critical responses for the archive.', href: url('/community/submissions/') },
  {
    title: 'Events',
    text: upcoming.length
      ? `${upcoming.length} forthcoming event${upcoming.length === 1 ? '' : 's'}.`
      : lastEvent
        ? `No events are scheduled. The most recent was in ${lastEvent.data.start.getUTCFullYear()}.`
        : 'No events are scheduled.',
    href: url('/community/events/'),
  },
  { title: 'Calls for papers', text: 'There are no open calls at present.', href: url('/community/calls/') },
  { title: 'Students', text: 'Studios, theses and workshops in which the approach has been taught.', href: url('/community/students/') },
  { title: 'Discussions and responses', text: 'Critical questions raised about the approach, and how to add to them.', href: url('/community/discussions/') },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: settings.title,
  description: settings.description,
  inLanguage: 'en-GB',
};
---

<Base jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero__meta">
        <p class="label">An intellectual movement and architectural philosophy</p>
      </div>
      <h1 class="hero__title" id="hero-title">
        <span>New</span>
        <span>Contextualism</span>
      </h1>
      <div class="grid hero__intro">
        <p class="hero__tagline" data-approved={settings.taglineApproved ? 'true' : 'false'}>
          {settings.tagline.split('. ').map((line, i, all) => (i < all.length - 1 ? <span>{line}.</span> : <span>{line}</span>))}
        </p>
        <div class="hero__text">
          <p>{settings.description}</p>
          <p class="hero__links">
            <a class="arrow-link" href={url('/philosophy/')}>Explore the Philosophy <span class="arrow" aria-hidden="true">↗</span></a>
            <a class="arrow-link" href={url('/research/')}>Discover the Research <span class="arrow" aria-hidden="true">↗</span></a>
          </p>
        </div>
      </div>
      <Plate
        class="hero__plate"
        src={HERO_PLATE.src}
        alt={HERO_PLATE.alt}
        width={HERO_PLATE.width}
        height={HERO_PLATE.height}
        number="Plate I"
        caption={HERO_PLATE.caption}
        eager
        reveal={false}
        sizes="100vw"
      />
    </div>
  </section>

  <!-- 0.1 Start here -->
  <section class="section start" aria-labelledby="start-title">
    <div class="wrap">
      <SectionHead label="Start Here" id="start-here" />
      <div class="grid start__head">
        <h2 class="col-title" id="start-title" data-reveal>How to use New Contextualism.</h2>
        <p class="col-intro" data-reveal>
          The platform is organised in six sections, from the philosophy to the people who develop it. Five ways in, for a first
          visit:
        </p>
      </div>
      <ol class="steps" role="list">
        {
          steps.map((s) => (
            <li data-reveal>
              <a href={s.href}>
                <span class="steps__title">{s.title}</span>
                <span class="steps__text">{s.text}</span>
                <span class="steps__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 0.2 Introduction and core proposition -->
  <section class="section idea" aria-labelledby="idea-title">
    <div class="wrap">
      <SectionHead label={head('0.2').title} id="introduction" />
      <div class="grid">
        <h2 class="idea__title" id="idea-title" data-reveal>Context is more than what surrounds us.</h2>
        <div class="idea__text" data-reveal>
          <p class="lede">
            Every place is shaped by visible and invisible forces. Histories, social relationships, cultural practices, ecological
            processes, political structures, and everyday life contribute to the meaning of the built environment.
          </p>
          <p>
            New Contextualism approaches architecture and urbanism through these interconnected conditions, seeking a deeper
            understanding of place and the possibilities for meaningful transformation.
          </p>
          <Provenance kind="editorial-summary" approval="pending" />
          <Quote
            class="idea__quote"
            text="Context, in the New Contextualist framework, transcends the immediate physical site."
            author="Mohammad Habib Reza"
            source="The Daily Star"
            label={label(DS)}
            href={to.record(DS)}
          />
          <a class="arrow-link" href={url('/philosophy/definition-and-scope/')}>Definition and scope <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 0.3 Key ideas -->
  <section class="section ideas" aria-labelledby="ideas-title">
    <div class="wrap">
      <SectionHead label="Key Ideas" id="key-ideas" />
      <div class="grid ideas__head">
        <h2 class="col-title" id="ideas-title" data-reveal>The approach in six ideas.</h2>
        <div class="col-intro" data-reveal>
          <p>Each idea is summarised by the editors and quoted from the founder’s published writing.</p>
          <Provenance kind="editorial-summary" approval="pending" />
        </div>
      </div>
      <ol class="ideas__list" role="list">
        {
          ideas.map((idea) => (
            <li data-reveal>
              <h3 class="ideas__title">{idea.title}</h3>
              <p class="ideas__quote">‘{idea.quote}’</p>
              <p class="ideas__text">{idea.text}</p>
              <p class="ideas__cite small">
                <a href={to.record(idea.source)}>{label(idea.source)}</a>
              </p>
            </li>
          ))
        }
      </ol>
      <p class="more">
        <a class="arrow-link" href={url('/philosophy/principles/')}>Propositions and principles <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- 0.4 The ten contextual layers -->
  <section class="section framework" aria-labelledby="framework-title">
    <div class="wrap">
      <SectionHead label="The Ten Contextual Layers" id="layers" />
      <div class="grid framework__head">
        <h2 class="framework__title" id="framework-title" data-reveal>Ten layers. Interconnected realities.</h2>
        <div class="framework__intro" data-reveal>
          <p>
            The founder’s writing describes context as a ‘tenfold matrix’ of overlapping layers. None is read alone: each is
            entangled with the others, and every project weighs them differently.
          </p>
          <p class="small muted">
            Layers and their terms from <a href={to.record(DS)}>{label(DS)}</a>, where they are called dimensions. The relations
            traced here are an editorial interpretation.
          </p>
        </div>
      </div>
      <DimensionGrid dimensions={dims} />
      <p class="more more--pair">
        <a class="arrow-link" href={to.layers()}>The ten layers defined <span class="arrow" aria-hidden="true">→</span></a>
        <a class="arrow-link arrow-link--quiet" href={to.framework()}>Explore the contextual diagram <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- 0.5 Explore the philosophy -->
  <section class="section explore" aria-labelledby="philosophy-title">
    <div class="wrap">
      <SectionHead label="Explore the Philosophy" id="philosophy" />
      <div class="grid explore__head">
        <h2 class="col-title" id="philosophy-title" data-reveal>A philosophy in development.</h2>
        <p class="col-intro" data-reveal>{philosophy.summary} Ten parts, each drawn from the published record.</p>
      </div>
      <ol class="toc-grid" role="list">
        {
          philosophy.pages.map((p) => (
            <li data-reveal>
              <a href={url(p.path)}>
                <span class="toc-grid__name">{p.title === 'Overview' ? 'Overview' : p.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 0.6 Explore the methodologies and frameworks -->
  <section class="section explore" aria-labelledby="methodologies-title">
    <div class="wrap">
      <SectionHead label="Explore the Methodologies and Frameworks" id="methodologies" />
      <div class="grid explore__head">
        <h2 class="col-title" id="methodologies-title" data-reveal>From reading to design.</h2>
        <div class="col-intro" data-reveal>
          <p>
            New Contextualism is presented as a process before it is a form. Every project is said to begin with three phases,
            with particular weight on the first (<a href={to.record(CBD)}>{label(CBD)}</a>).
          </p>
        </div>
      </div>
      <ol class="phases" role="list">
        {
          phases.map((ph, i) => (
            <li data-reveal>
              <span class="label">Phase {i + 1}</span>
              <h3 class="phases__name">{ph.name}</h3>
              <p>{ph.text}</p>
            </li>
          ))
        }
      </ol>
      <ol class="toc-grid toc-grid--quiet" role="list">
        {
          methodologies.pages.map((p) => (
            <li data-reveal>
              <a href={url(p.path)}>
                <span class="toc-grid__name">{p.title === 'Overview' ? 'Overview' : p.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 0.7 Featured projects and case studies -->
  <section class="section practice" aria-labelledby="practice-title">
    <div class="wrap">
      <SectionHead label="Featured Projects and Case Studies" id="projects" />
      <div class="grid practice__head">
        <h2 class="practice__title" id="practice-title" data-reveal>Thinking through places.</h2>
        <div class="practice__intro" data-reveal>
          <p>
            Theses, studio projects and competition entries in which the framework has been applied, documented from published
            sources. The drawings that accompany them are abstract editorial plates, not drawings of the projects.
          </p>
          <ul class="practice__counts" role="list">
            {
              counts.map((c) => (
                <li>
                  <span class={`status status--${c.status}`}>{STATUS_LABELS[c.status]}</span>
                  <span class="num">{c.n}</span>
                </li>
              ))
            }
          </ul>
          <p class="small muted">No built works have yet been documented on this platform.</p>
        </div>
      </div>
      <div class="grid practice__gallery">
        {
          featured.map((p, i) => (
            <div class={`practice__item practice__item--${i}`} data-reveal>
              <ProjectCard
                project={p}
                dimensions={dims}
                ratio={i === 3 ? '16 / 10' : '4 / 3'}
                sizes={i === 0 || i === 3 ? '(min-width: 900px) 55vw, 100vw' : '(min-width: 900px) 35vw, 100vw'}
              />
            </div>
          ))
        }
      </div>
      <p class="more more--pair">
        <a class="arrow-link" href={url('/projects/featured/')}>Featured projects <span class="arrow" aria-hidden="true">→</span></a>
        <a class="arrow-link arrow-link--quiet" href={to.projects()}>All projects, as a list or on a map <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- 0.8 Latest research and publications -->
  <section class="section archive" aria-labelledby="archive-title">
    <div class="wrap">
      <SectionHead label="Latest Research and Publications" id="research" />
      <div class="grid archive__head">
        <h2 class="archive__title" id="archive-title" data-reveal>An ongoing conversation.</h2>
        <div class="archive__intro" data-reveal>
          <p>
            Essays, articles, lectures and reports that make up the published record of New Contextualism, alongside the founder’s
            research on the history of Bengal. Every record has a persistent address and a full citation.
          </p>
          <p class="archive__stats label">
            {allRecords.length} records · {types.size} types · {Math.min(...years)}–{Math.max(...years)}
          </p>
        </div>
      </div>
      <div data-reveal>
        <RecordList reg={reg} records={latest} compact />
      </div>
      <p class="more">
        <a class="arrow-link" href={to.archive()}>Browse the full archive, with filters <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- 0.9 Join the community -->
  <section class="section community" aria-labelledby="community-title">
    <div class="wrap">
      <SectionHead label="Join the Community" id="community" />
      <div class="grid">
        <h2 class="community__title" id="community-title" data-reveal>Context crosses disciplines.</h2>
        <div class="community__body" data-reveal>
          <p class="lede">
            New Contextualism has developed through design studios, workshops, lectures and symposia, and through exchange between
            practice and academia.
          </p>
          <p>
            This platform is intended as a place for that dialogue to continue, across disciplines and between local conditions and
            wider systems. It is not a membership organisation; the ways to take part are set out below.
          </p>
          <Provenance kind="proposed" approval="pending" />
        </div>
      </div>
      <ul class="community__links" role="list">
        {
          community.map((c) => (
            <li data-reveal>
              <a href={c.href}>
                <span class="community__name">{c.title}</span>
                <span class="community__text">{c.text}</span>
                <span class="community__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .hero__meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-bottom: clamp(1.5rem, 1rem + 2.5vw, 3.5rem);
  }

  .hero__title {
    font-size: var(--fs-mast);
    line-height: 0.82;
    letter-spacing: -0.012em;
    text-transform: uppercase;
    margin-left: -0.04em;
  }

  .hero__title span {
    display: block;
  }

  .hero__intro {
    margin-top: clamp(2rem, 1.5rem + 2.5vw, 4rem);
    row-gap: 1.5rem;
    align-items: start;
  }

  .hero__tagline {
    grid-column: 1 / span 5;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem);
    line-height: 1.08;
  }

  .hero__tagline span {
    display: block;
  }

  .hero__text {
    grid-column: 7 / span 5;
    display: grid;
    gap: 1.5rem;
    font-size: 1.0625rem;
    max-width: 30rem;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  .hero__plate {
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .hero__plate :global(.plate__frame) {
    aspect-ratio: 2400 / 1100;
  }

  /* On small screens the plate is cropped to a taller frame so it stays legible. */
  @media (max-width: 640px) {
    .hero__plate :global(.plate__frame) {
      aspect-ratio: 4 / 3;
    }

    .hero__plate :global(img) {
      object-position: 62% 50%;
    }
  }

  /* Shared section heads */
  .col-title {
    grid-column: 1 / span 6;
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 3.75rem);
    line-height: 1.02;
  }

  .col-intro {
    grid-column: 8 / span 5;
    display: grid;
    gap: 1rem;
    align-content: end;
  }

  .start__head,
  .ideas__head,
  .explore__head,
  .framework__head,
  .practice__head,
  .archive__head {
    row-gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    align-items: end;
  }

  .more {
    margin-top: 2.5rem;
  }

  .more--pair {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  /* 0.1 Start here */
  .steps {
    margin: 0;
    border-top: 1px solid var(--ink);
  }

  .steps a {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) 2rem;
    gap: 0.5rem var(--col-gap);
    align-items: baseline;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .steps__title {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.125rem);
    line-height: 1.1;
    transition: color 0.3s var(--ease);
  }

  .steps__text {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .steps__arrow {
    justify-self: end;
    transition: transform 0.3s var(--ease);
  }

  .steps a:hover .steps__title {
    color: var(--brick);
  }

  .steps a:hover .steps__arrow {
    transform: translateX(4px);
  }

  /* 0.2 Introduction */
  .idea__title {
    grid-column: 1 / span 4;
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 3.75rem);
    line-height: 1.02;
  }

  .idea__text {
    grid-column: 6 / span 6;
    display: grid;
    gap: 1.5rem;
    max-width: 40rem;
  }

  .idea__quote {
    margin: 1.5rem 0 0.5rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--brick);
  }

  /* 0.3 Key ideas */
  .ideas__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem var(--col-gap);
    margin: 0;
  }

  .ideas__list li {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
  }

  .ideas__title {
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.25rem);
    line-height: 1.08;
  }

  .ideas__quote {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .ideas__text {
    font-size: 0.9375rem;
    color: var(--ink-2);
    max-width: 24rem;
  }

  .ideas__cite a {
    text-decoration-color: var(--rule);
  }

  /* 0.4 The ten layers */
  .framework__title,
  .practice__title,
  .archive__title,
  .community__title {
    grid-column: 1 / span 7;
  }

  .framework__intro,
  .practice__intro,
  .archive__intro {
    grid-column: 9 / span 4;
    display: grid;
    gap: 1rem;
  }

  /* 0.5 and 0.6 Indexes of the sections */
  .toc-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--col-gap);
    margin: 0;
    border-top: 1px solid var(--ink);
  }

  .toc-grid a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .toc-grid__name {
    font-family: var(--serif);
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.75rem);
    line-height: 1.15;
    transition: color 0.3s var(--ease);
  }

  .toc-grid a:hover .toc-grid__name {
    color: var(--brick);
  }

  .toc-grid--quiet {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .toc-grid--quiet .toc-grid__name {
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem);
  }

  .phases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem var(--col-gap);
    margin: 0;
  }

  .phases li {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
  }

  .phases li:first-child {
    border-top-width: 2px;
  }

  .phases__name {
    font-size: clamp(2.25rem, 1.6rem + 2vw, 3.5rem);
    line-height: 1;
  }

  .phases p {
    font-size: 0.9375rem;
    color: var(--ink-2);
    max-width: 22rem;
  }

  /* 0.7 Projects */
  .practice__counts {
    display: grid;
    gap: 0.35rem;
