---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import Provenance from '../components/Provenance.astro';
import Quote from '../components/Quote.astro';
import Chronology from '../components/Chronology.astro';
import Bibliography from '../components/Bibliography.astro';
import { citations, registry } from '../lib/content';
import { chronology, settings } from '../lib/site';
import { url } from '../lib/url';

const reg = await registry();
const cite = citations(reg, 'movement');
const ref = (key: string): [string, string] => {
  cite.add(key);
  return [cite.label(key), `#ref-${key}`];
};

const TBS = ref('reza-2023-new-contextualism-path');
const DS = ref('reza-2025-deltaic-bangladesh');
const CBD = ref('reza-nitu-2025-people-place-justice');
const BRACU = ref('bracu-2023-workshop-report');

/** Published formulations of the principles, aligned by theme (editorial alignment). */
const formulations = [
  { label: 'June 2023', title: 'Workshop at BRAC University', cite: BRACU },
  { label: 'April 2025', title: 'The Daily Star', cite: DS },
  { label: 'September 2025', title: 'Context BD', cite: CBD },
];
const themes: { theme: string; cells: (string | null)[] }[] = [
  {
    theme: 'Anticipating the future',
    cells: [
      'Forward-looking design informed by accurate predictions of the future',
      'Forward-Thinking Design Anchored in Prediction',
      'Forward-thinking design; Informed by prediction',
    ],
  },
  {
    theme: 'Learning from history',
    cells: [
      'A profound understanding of historical trends',
      'Historical Grounding as Foundational Knowledge',
      'Learning from the past',
    ],
  },
  {
    theme: 'A broad reading of context',
    cells: [
      'Recognition of the diverse and extensive nature of context',
      'Holistic Context Understanding – The Tenfold Matrix',
      'A broad sense of context',
    ],
  },
  {
    theme: 'The universal and the particular',
    cells: [null, 'Balancing the Universal and the Particular – The Art of Hybridization', null],
  },
  {
    theme: 'Adaptability and resilience',
    cells: [null, 'Designing for Adaptability and Resilience', null],
  },
  {
    theme: 'Equity and justice',
    cells: [
      'A focus on equity and justice through inclusive and diverse designs',
      null,
      'Equity and justice',
    ],
  },
];

// Quoted verbatim from Reza and Nitu (2025).
const pillars = [
  {
    title: 'Sense of place and identity',
    quote: 'Sense of place and identity, honoring culture and memory while embracing contemporary design.',
  },
  {
    title: 'Sustainability',
    quote: 'Sustainability minimizes energy, carbon, and waste while adapting to the local climate.',
  },
  {
    title: 'Social engagement',
    quote: 'Social engagement creates inclusive, life-giving spaces that encourage interaction and well-being.',
  },
];

const focusAreas = [
  {
    title: 'Nature-inspired design',
    text: 'Learning from the strategies by which local ecosystems and organisms thrive in specific conditions.',
  },
  {
    title: 'Deep sustainability integration',
    text: 'Embedding sustainability across the design lifecycle, from material sourcing to waste reduction, beyond superficial ‘greenwashing’.',
  },
  {
    title: 'Alignment with the SDGs',
    text: 'Mapping design intentions and outcomes against the United Nations Sustainable Development Goals.',
  },
  {
    title: 'Proactive resilience',
    text: 'Anticipating future climate impacts, such as sea-level rise and increased storm intensity.',
  },
];
cite.add('united-nations-2015-agenda-2030');
chronology.forEach((c) => c.sources.forEach((k) => cite.add(k)));
---

<Base
  title="The Movement"
  description="What New Contextualism proposes, how its principles have been formulated, its origins and chronology, and the proposed mission of this platform."
>
  <PageHeader
    label="The Movement"
    title="The Movement"
    intro="A developing philosophy of architecture and urban design, shared through teaching, writing, workshops and symposia. This page sets out what it proposes, how its principles have been formulated, and where it came from."
  />

  <section class="section movement-what" aria-labelledby="what-title">
    <div class="wrap">
      <SectionHead index="01" label="What it proposes" />
      <div class="grid">
        <h2 class="col-title" id="what-title">A forward-looking reading of context.</h2>
        <div class="col-body">
          <Quote
            text="New Contextualism is a forward-thinking philosophy that advocates for creating built environments informed by accurate predictions of the future, deeply rooted in the past and encompassing a holistic understanding of the context."
            author="Mohammad Habib Reza"
            source="The Business Standard"
            label={TBS[0]}
            href={TBS[1]}
          />
          <div class="prose">
            <p>
              The approach treats context as far more than the physical surroundings of a site. It reads places through ten
              overlapping dimensions, draws on history as the basis for anticipating the future, and places equity and justice at
              the centre of design (<a href={TBS[1]}>{TBS[0]}</a>; <a href={DS[1]}>{DS[0]}</a>). Its proponents describe it as
              process-based rather than style-based: what is new lies in a method of reading and weighing context, not in a
              recognisable architectural form (<a href={CBD[1]}>{CBD[0]}</a>).
            </p>
          </div>
          <Provenance kind="editorial-summary" approval="pending" />
        </div>
      </div>

      <div class="pillars">
        <p class="label">Three aims, as summarised by Reza and Nitu (2025)</p>
        <ol class="pillars__list" role="list">
          {
            pillars.map((p, i) => (
              <li data-reveal>
                <span class="pillars__num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="pillars__title">{p.title}</h3>
                <p class="pillars__text">‘{p.quote}’</p>
              </li>
            ))
          }
        </ol>
        <p class="small muted">
          Quoted from <a href={CBD[1]}>{CBD[0]}</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section movement-principles" aria-labelledby="principles-title">
    <div class="wrap">
      <SectionHead index="02" label="Principles" />
      <div class="grid">
        <h2 class="col-title" id="principles-title">Principles, as they have been formulated.</h2>
        <div class="col-body prose">
          <p>
            The principles of New Contextualism have been stated several times, with different emphases. The table aligns three
            published formulations by theme, quoting the principles as they appear in each source. Reading across a row shows
            how an idea has been carried forward; empty cells show where a formulation does not name it as a principle.
          </p>
          <Provenance kind="interpretation" note="Editorial alignment of quoted principles" />
        </div>
      </div>

      <div class="formulations" data-reveal>
        <table>
          <caption class="visually-hidden">Principles of New Contextualism in three published formulations, aligned by theme</caption>
          <thead>
            <tr>
              <th scope="col"><span class="label">Theme</span></th>
              {
                formulations.map((f) => (
                  <th scope="col">
                    <span class="formulations__date">{f.label}</span>
                    <span class="formulations__source">
                      {f.title} (<a href={f.cite[1]}>{f.cite[0]}</a>)
                    </span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              themes.map((t) => (
                <tr>
                  <th scope="row">{t.theme}</th>
                  {t.cells.map((c) => (c ? <td>{c}</td> : <td class="formulations__empty">Not named as a principle</td>))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="formulations__note small muted">
        In April 2025 equity and justice are described as ‘central to its ethos’ rather than listed among the tenets
        (<a href={DS[1]}>{DS[0]}</a>). The September 2025 essay adds a sequence of three phases (Read, Plan and Process) and
        a ten-layer lens that differs slightly from the ten dimensions (<a href={CBD[1]}>{CBD[0]}</a>); see the
        <a href={url('/philosophy/#ten-dimensions')}>Philosophy</a>.
      </p>
    </div>
  </section>

  <section class="section movement-next" aria-labelledby="next-title">
    <div class="wrap">
      <SectionHead index="03" label="Development" />
      <div class="grid">
        <h2 class="col-title" id="next-title">New Contextualism 2.0</h2>
        <div class="col-body prose">
          <p>
            The founder’s 2025 essay describes a further stage of the approach, the outcome of ongoing work at BRAC University. It
            reflects ‘a heightened urgency regarding global environmental challenges and a more explicit integration of
            contemporary sustainability frameworks’ (<a href={DS[1]}>{DS[0]}</a>).
          </p>
          <Provenance kind="editorial-summary" approval="pending" />
        </div>
      </div>
      <ol class="focus" role="list">
        {
          focusAreas.map((f, i) => (
            <li data-reveal>
              <span class="label">{String(i + 1).padStart(2, '0')}</span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="small muted">
        Summarised from <a href={DS[1]}>{DS[0]}</a>. On the Sustainable Development Goals, see
        <a href="#ref-united-nations-2015-agenda-2030">{cite.label('united-nations-2015-agenda-2030')}</a>.
      </p>
    </div>
  </section>

  <section class="section movement-origins" id="origins" aria-labelledby="origins-title">
    <div class="wrap">
      <SectionHead index="04" label="Origins" />
      <div class="grid">
        <h2 class="col-title" id="origins-title">From the delta to the studio.</h2>
        <div class="col-body prose">
          <p>
            The founder traces the approach to two experiences: early work as an architect-planner for the Barisal City
            Corporation, reconciling new interventions with existing urban fabric in a deltaic environment, and doctoral research
            on the early Buddhist architecture of Bengal, whose monasteries he describes as shaped by climate, local materials,
            ritual and ways of life (<a href={TBS[1]}>{TBS[0]}</a>; <a href={DS[1]}>{DS[0]}</a>). Since then it has been
            cultivated for more than a decade at BRAC University, in studios and thesis supervision (<a href={TBS[1]}>{TBS[0]}</a>;
            <a href={CBD[1]}>{CBD[0]}</a>).
          </p>
          <Provenance kind="editorial-summary" approval="pending" />
        </div>
      </div>
      <div class="origins__chronology">
        <Chronology items={chronology} cite={ref} />
      </div>
      <p class="origins__more">
        <a class="arrow-link" href={url('/philosophy/#origins')}>Read the full account in the Philosophy <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <section class="section movement-mission" aria-labelledby="mission-title">
    <div class="wrap">
      <SectionHead index="05" label="Mission and vision" />
      <h2 class="visually-hidden" id="mission-title">Mission and vision</h2>
      <div class="grid statements">
        <div class="statement" data-reveal>
          <p class="label">Mission</p>
          <p class="statement__text">{settings.mission.text}</p>
          <Provenance kind={settings.mission.provenance} approval="pending" />
        </div>
        <div class="statement" data-reveal>
          <p class="label">Vision</p>
          <p class="statement__text">{settings.vision.text}</p>
          <Provenance kind={settings.vision.provenance} approval="pending" />
        </div>
      </div>
      <p class="small muted statements__note">
        These statements are drafts put forward for discussion. They have no official status until approved by the founder.
      </p>
    </div>
  </section>

  <section class="section movement-join" aria-labelledby="join-title">
    <div class="wrap">
      <SectionHead index="06" label="Taking part" />
      <div class="grid">
        <h2 class="col-title" id="join-title">An open conversation.</h2>
        <div class="col-body">
          <p class="lede">
            Architects, urban designers, academics, researchers and students are invited to engage with the approach: to apply it,
            test it and question it.
          </p>
          <p class="join__links">
            <a class="arrow-link" href={url('/dialogue/')}>Dialogue and events <span class="arrow" aria-hidden="true">→</span></a>
            <a class="arrow-link arrow-link--quiet" href={url('/contact/')}>Write to the editors <span class="arrow" aria-hidden="true">→</span></a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="section">
    <div class="wrap">
      <div class="grid">
        <div class="sources">
          <Bibliography reg={reg} keys={cite.cited()} />
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .col-title {
    grid-column: 1 / span 5;
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 3.75rem);
    line-height: 1.02;
  }

  .col-body {
    grid-column: 7 / span 6;
    display: grid;
    gap: 1.5rem;
    max-width: 40rem;
  }

  .sources {
    grid-column: 1 / -1;
  }

  /* Aims */
  .pillars {
    margin-top: clamp(3.5rem, 3rem + 3vw, 6rem);
  }

  .pillars__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--col-gap);
    margin: 1rem 0 1rem;
  }

  .pillars__list li {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
  }

  .pillars__num {
    font-size: 0.75rem;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .pillars__title {
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.25rem);
  }

  .pillars__text {
    font-size: 0.9375rem;
    color: var(--ink-2);
    max-width: 22rem;
  }

  /* Formulations */
  .formulations {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    overflow-x: auto;
  }

  .formulations table {
    width: 100%;
    min-width: 46rem;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .formulations th,
  .formulations td {
    padding: 1rem 1.25rem 1.1rem 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
    font-weight: 400;
  }

  .formulations thead th {
    border-bottom: 1px solid var(--ink);
    vertical-align: bottom;
  }

  .formulations thead th:first-child {
    width: 18%;
  }

  .formulations__date {
    display: block;
    font-family: var(--serif);
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .formulations__source {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .formulations tbody th {
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .formulations td {
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .formulations__empty {
    color: var(--ink-2);
    font-size: 0.8125rem !important;
    font-style: italic;
  }

  .formulations__note {
    margin-top: 1.25rem;
    max-width: 48rem;
  }

  /* 2.0 */
  .focus {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--col-gap);
    margin: clamp(3rem, 2rem + 3vw, 5rem) 0 1rem;
  }

  .focus li {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
  }

  .focus h3 {
    font-size: 1.625rem;
    line-height: 1.1;
  }

  .focus p {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  /* Origins */
  .origins__chronology {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .origins__more {
    margin-top: 2rem;
  }

  /* Statements */
  .statements {
    row-gap: 3rem;
  }

  .statement {
    grid-column: span 6;
    display: grid;
    align-content: start;
    gap: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
  }

  .statement__text {
    font-family: var(--serif);
    font-size: clamp(1.75rem, 1.3rem + 1.5vw, 2.75rem);
    line-height: 1.12;
    max-width: 26ch;
  }

  .statements__note {
    margin-top: 2rem;
    max-width: 40rem;
  }

  .join__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  @media (max-width: 900px) {
    .col-title,
    .col-body,
    .statement {
      grid-column: 1 / -1;
    }

    .col-body {
      margin-top: 1.75rem;
    }

    .pillars__list {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .focus {
      grid-template-columns: 1fr 1fr;
      row-gap: 2rem;
    }
  }

  @media (max-width: 560px) {
    .focus {
      grid-template-columns: 1fr;
    }
  }
</style>
