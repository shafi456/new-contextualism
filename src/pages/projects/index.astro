---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { listed, registry } from '../../lib/content';
import { STATUS_DESCRIPTIONS, STATUS_LABELS } from '../../lib/provenance';
import { pad } from '../../lib/format';
import { url } from '../../lib/url';

const reg = await registry();
const projects = listed(reg.projects);
const groups = (['completed', 'ongoing', 'conceptual'] as const).map((status) => ({
  status,
  items: projects.filter((p) => p.data.status === status),
}));
const PLURAL = {
  completed: 'Completed projects',
  ongoing: 'Ongoing research',
  conceptual: 'Conceptual proposals',
};
---

<Base
  title="Projects"
  description="Conceptual proposals and ongoing research in which New Contextualism has been applied, documented from published sources."
>
  <PageHeader
    label="Projects"
    title="Thinking through places."
    intro="Theses, studio projects, competition entries and research in which the framework has been applied. Each is documented only from published sources, with those sources cited."
    compact
  >
    <dl class="legend">
      {
        groups.map((g) => (
          <div class="legend__row">
            <dt>
              <span class={`status status--${g.status}`}>{STATUS_LABELS[g.status]}</span>
            </dt>
            <dd class="legend__desc">{STATUS_DESCRIPTIONS[g.status]}</dd>
            <dd class="legend__n num">{pad(g.items.length)}</dd>
          </div>
        ))
      }
    </dl>
  </PageHeader>

  <div class="wrap notice-wrap">
    <p class="notice">
      <span class="label">About the images</span>
      The drawings that accompany these projects are abstract editorial plates made for this platform. They are not drawings of the
      projects. Photographs and drawings of each project will be added only with the permission of its authors.
    </p>
  </div>

  {
    groups.map((g, gi) => (
      <section class="section project-group" id={g.status} aria-labelledby={`${g.status}-title`}>
        <div class="wrap">
          <SectionHead index={pad(gi + 1)} label={PLURAL[g.status]} />
          <h2 class="visually-hidden" id={`${g.status}-title`}>
            {PLURAL[g.status]}
          </h2>
          {g.items.length ? (
            <div class="grid project-grid">
              {g.items.map((p, i) => (
                <div class:list={['project-grid__item', { 'project-grid__item--wide': g.items.length > 2 && i % 5 === 0 }]} data-reveal>
                  <ProjectCard project={p} dimensions={reg.dimensions} headingLevel={3} sizes="(min-width: 900px) 45vw, 100vw" />
                </div>
              ))}
            </div>
          ) : (
            <div class="pending project-group__empty">
              <span class="label">None documented</span>
              No {PLURAL[g.status].toLowerCase()} have yet been documented on this platform. Documentation of built work can be
              proposed to the editors through the <a href={url('/contact/')}>Contact</a> page.
            </div>
          )}
        </div>
      </section>
    ))
  }
</Base>

<style>
  .legend {
    margin: 0;
    border-top: 1px solid var(--ink);
  }

  .legend__row {
    display: grid;
    grid-template-columns: 13rem 1fr 3rem;
    gap: 1rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.875rem;
  }

  .legend__desc {
    color: var(--ink-2);
  }

  .legend__n {
    justify-self: end;
    font-family: var(--serif);
    font-size: 1.5rem;
    line-height: 1;
  }

  .notice-wrap {
    margin-bottom: 1rem;
  }

  .notice {
    display: grid;
    gap: 0.4rem;
    max-width: 52rem;
    padding: 1rem 0 0;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .project-group + .project-group {
    padding-top: 0;
  }

  .project-grid {
    row-gap: clamp(3.5rem, 2.5rem + 3vw, 6rem);
  }

  .project-grid__item {
    grid-column: span 6;
  }

  .project-grid__item:nth-child(even) {
    padding-top: clamp(0rem, 6vw, 6rem);
  }

  .project-group__empty {
    max-width: 44rem;
  }

  @media (max-width: 900px) {
    .project-grid__item {
      grid-column: 1 / -1;
      padding-top: 0 !important;
    }

    .legend__row {
      grid-template-columns: 1fr 3rem;
    }

    .legend__desc {
      grid-column: 1;
      grid-row: 2;
    }

    .legend__n {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>
