---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHead from '../../components/SectionHead.astro';
import RecordList from '../../components/RecordList.astro';
import Bibliography from '../../components/Bibliography.astro';
import { archiveRecords, listed, registry } from '../../lib/content';
import { pubYear } from '../../lib/cite';
import { displayName, familyName } from '../../lib/format';
import { COLLECTION_LABELS, TYPE_LABELS } from '../../lib/provenance';

const reg = await registry();
const records = archiveRecords(reg);

const count = <T extends string>(values: T[]) => {
  const m = new Map<T, number>();
  values.forEach((v) => m.set(v, (m.get(v) ?? 0) + 1));
  return m;
};
const types = [...count(records.map((r) => r.data.type))].sort((a, b) => TYPE_LABELS[a[0]].localeCompare(TYPE_LABELS[b[0]]));
const authorNames = records.flatMap((r) => [...r.data.authors, ...r.data.editors]);
const authors = [...count(authorNames)]
  .sort((a, b) => familyName(a[0]).localeCompare(familyName(b[0])))
  .map(([name, n]) => ({ value: displayName(name).toLowerCase(), label: displayName(name), n }));
const years = [...count(records.map((r) => String(pubYear(r) ?? '')).filter(Boolean))].sort((a, b) => b[0].localeCompare(a[0]));
const dims = reg.dimensions
  .map((d) => ({ d, n: records.filter((r) => r.data.dimensions.includes(d.id)).length }))
  .filter((x) => x.n > 0);
const topics = [...count(records.flatMap((r) => r.data.topics.map((t) => t.toLowerCase())))].sort((a, b) => a[0].localeCompare(b[0]));
const collections = [...count(records.map((r) => r.data.collection))];

const references = listed(reg.publications)
  .filter((p) => p.data.collection === 'reference')
  .map((p) => p.id);
const sources = listed(reg.publications)
  .filter((p) => p.data.collection === 'source')
  .map((p) => p.id);
---

<Base
  title="Research"
  description="The archive of New Contextualism: essays, lectures and reports, with the founder’s earlier scholarship. Filter by type, author, year, dimension and topic."
>
  <PageHeader
    label="Research"
    title="An ongoing conversation."
    intro="The published record of New Contextualism, alongside the scholarship from which it grew. Every record has a persistent address and a citation."
    compact
  />

  <section class="archive" aria-labelledby="archive-title">
    <div class="wrap">
      <SectionHead index="01" label="The archive" />
      <h2 class="visually-hidden" id="archive-title">The archive</h2>

      <form class="filters" data-filters hidden aria-label="Filter the archive">
        <div class="filters__grid">
          <label class="filter filter--search">
            <span class="label">Search within the archive</span>
            <input type="search" name="q" autocomplete="off" placeholder="Title, author, venue or topic" />
          </label>
          <label class="filter">
            <span class="label">Type</span>
            <select name="type">
              <option value="">All types</option>
              {types.map(([t, n]) => <option value={t}>{`${TYPE_LABELS[t]} (${n})`}</option>)}
            </select>
          </label>
          <label class="filter">
            <span class="label">Author</span>
            <select name="author">
              <option value="">All authors</option>
              {authors.map((a) => <option value={a.value}>{`${a.label} (${a.n})`}</option>)}
            </select>
          </label>
          <label class="filter">
            <span class="label">Year</span>
            <select name="year">
              <option value="">All years</option>
              {years.map(([y, n]) => <option value={y}>{`${y} (${n})`}</option>)}
            </select>
          </label>
          <label class="filter">
            <span class="label">Dimension</span>
            <select name="dimension">
              <option value="">All dimensions</option>
              {dims.map(({ d, n }) => <option value={d.id}>{`${d.data.name} (${n})`}</option>)}
            </select>
          </label>
          <label class="filter">
            <span class="label">Topic</span>
            <select name="topic">
              <option value="">All topics</option>
              {topics.map(([t, n]) => <option value={t}>{`${t[0].toUpperCase()}${t.slice(1)} (${n})`}</option>)}
            </select>
          </label>
          <label class="filter">
            <span class="label">Collection</span>
            <select name="collection">
              <option value="">Both collections</option>
              {collections.map(([c, n]) => <option value={c}>{`${COLLECTION_LABELS[c]} (${n})`}</option>)}
            </select>
          </label>
        </div>
        <div class="filters__foot">
          <p class="filters__count" role="status" aria-live="polite" data-filter-count></p>
          <button type="reset" class="filters__reset" data-filter-reset>Clear filters</button>
        </div>
      </form>

      <RecordList reg={reg} records={records} filterable />
      <p class="pending archive__empty" data-filter-empty hidden>
        <span class="label">No matching records</span>
        No records match these filters. <button type="button" class="link-button" data-filter-clear>Clear the filters</button> to see the
        whole archive.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="reading-title">
    <div class="wrap">
      <SectionHead index="02" label="Wider references" />
      <div class="grid">
        <div class="reading-intro">
          <h2 id="reading-title" class="reading-title">Works cited and further reading.</h2>
          <p class="small muted">
            Works listed in the references of New Contextualist texts, followed by an editorial selection of further reading on
            contextualism, place and urbanism. Inclusion here does not imply that an author is associated with the movement.
          </p>
        </div>
        <div class="reading-list">
          <Bibliography reg={reg} keys={references} heading="" headingLevel={2} />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="sources-title">
    <div class="wrap">
      <SectionHead index="03" label="Documentary sources" />
      <div class="grid">
        <div class="reading-intro">
          <h2 id="sources-title" class="reading-title">Profiles and listings.</h2>
          <p class="small muted">Web pages cited for biographical and event details, with the date they were consulted.</p>
        </div>
        <div class="reading-list">
          <Bibliography reg={reg} keys={sources} heading="" headingLevel={2} grouped={false} />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .archive {
    padding-bottom: var(--section);
  }

  .filters {
    margin-bottom: 2.5rem;
  }

  .filters__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.25rem var(--col-gap);
  }

  .filter {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .filter--search {
    grid-column: 1 / -1;
  }

  .filter input,
  .filter select {
    width: 100%;
    min-width: 0;
    padding: 0.5rem 0;
    border: 0;
    border-bottom: 1px solid var(--grey);
    border-radius: 0;
    background: transparent;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .filter input {
    font-family: var(--serif);
    font-size: 1.5rem;
  }

  .filter select {
    appearance: none;
    padding-right: 1.25rem;
    background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%), linear-gradient(135deg, var(--ink) 50%, transparent 50%);
    background-position:
      calc(100% - 7px) 55%,
      calc(100% - 3px) 55%;
    background-size: 4px 4px;
    background-repeat: no-repeat;
    text-overflow: ellipsis;
  }

  .filter input:focus,
  .filter select:focus {
    outline: none;
    border-bottom-color: var(--brick);
  }

  .filter input:focus-visible,
  .filter select:focus-visible {
    outline: 2px solid var(--brick);
    outline-offset: 3px;
  }

  .filters__foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .filters__count {
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .filters__reset {
    background: none;
    border: 0;
    padding: 0;
    font-size: 0.875rem;
    text-decoration: underline;
    text-decoration-color: var(--grey);
    text-underline-offset: 0.22em;
    color: var(--ink);
  }

  .archive__empty {
    margin-top: 1.5rem;
  }

  .reading-intro {
    grid-column: 1 / span 4;
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .reading-title {
    font-size: var(--fs-h3);
  }

  .reading-list {
    grid-column: 6 / span 7;
  }

  @media (max-width: 1080px) {
    .filters__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .reading-intro,
    .reading-list {
      grid-column: 1 / -1;
    }

    .reading-list {
      margin-top: 2rem;
    }
  }

  @media (max-width: 600px) {
    .filters__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-record]')];
  const count = document.querySelector<HTMLElement>('[data-filter-count]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
  const FIELDS = ['q', 'type', 'author', 'year', 'dimension', 'topic', 'collection'] as const;

  if (form) {
    form.hidden = false;
    const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null)?.value ?? '';

    const apply = (updateUrl = true) => {
      const q = value('q').trim().toLowerCase();
      const has = (attr: string | undefined, v: string) => !v || (attr ?? '').split('|').includes(v);
      let shown = 0;
      for (const row of rows) {
        const d = row.dataset;
        const match =
          (!q || q.split(/\s+/).every((t) => (d.text ?? '').includes(t))) &&
          (!value('type') || d.type === value('type')) &&
          has(d.authors, value('author')) &&
          (!value('year') || d.year === value('year')) &&
          has(d.dimensions, value('dimension')) &&
          has(d.topics, value('topic')) &&
          (!value('collection') || d.collection === value('collection'));
        row.hidden = !match;
        if (match) shown++;
      }
      if (count) {
        count.textContent =
          shown === rows.length ? `Showing all ${rows.length} records` : `Showing ${shown} of ${rows.length} records`;
      }
      if (empty) empty.hidden = shown > 0;
      if (updateUrl) {
        const params = new URLSearchParams();
        FIELDS.forEach((f) => value(f) && params.set(f, value(f)));
        const qs = params.toString();
        history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
      }
    };

    // Restore a shared view from the address bar.
    const params = new URLSearchParams(location.search);
    FIELDS.forEach((f) => {
      const el = form.elements.namedItem(f) as HTMLInputElement | HTMLSelectElement | null;
      const v = params.get(f);
      if (el && v !== null) el.value = v;
    });
    apply(false);

    let t = 0;
    form.addEventListener('input', () => {
      window.clearTimeout(t);
      t = window.setTimeout(() => apply(), 80);
    });
    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('reset', () => window.setTimeout(() => apply(), 0));
    document.querySelector('[data-filter-clear]')?.addEventListener('click', () => {
      form.reset();
    });
  }
</script>
