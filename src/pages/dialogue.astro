---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import Provenance from '../components/Provenance.astro';
import RecordList from '../components/RecordList.astro';
import Bibliography from '../components/Bibliography.astro';
import { archiveRecords, citations, eventIsUpcoming, registry } from '../lib/content';
import { formatDate } from '../lib/format';
import { EVENT_TYPE_LABELS } from '../lib/provenance';
import { url } from '../lib/url';

const reg = await registry();
const cite = citations(reg, 'dialogue');
const events = reg.events.filter((e) => !e.data.archived);
const upcoming = events.filter((e) => eventIsUpcoming(e)).reverse();
const past = events.filter((e) => !eventIsUpcoming(e));
const calls = upcoming.filter((e) => e.data.type === 'call-for-papers');
const gatherings = upcoming.filter((e) => e.data.type !== 'call-for-papers');
const lectures = archiveRecords(reg).filter((p) => p.data.type === 'lecture');
const rendered = new Map(events.map((e) => [e.id, cite.md(e.body)]));
events.forEach((e) => e.data.sources.forEach((k) => cite.add(k)));
const STUDIO = 'reza-nitu-2025-people-place-justice';
cite.add(STUDIO);

const when = (e: (typeof events)[number]) =>
  e.data.end && e.data.end.getTime() !== e.data.start.getTime()
    ? `${formatDate(e.data.start)} – ${formatDate(e.data.end)}`
    : formatDate(e.data.start);
const FORMAT = { 'in-person': 'In person', online: 'Online', hybrid: 'In person and online' } as const;
---

<Base
  title="Dialogue and events"
  description="Ways to engage with New Contextualism: research contributions, academic collaborations, lectures and seminars, calls for papers, workshops and events."
>
  <PageHeader
    label="Dialogue"
    title="Context crosses disciplines."
    intro="Ways to engage with New Contextualism: contributing research, collaborating, attending lectures and workshops, and responding to calls for papers."
    compact
  >
    <p class="small muted">
      This platform is not a membership organisation and charges no fees. The descriptions below set out how contributions are
      handled; they are proposals pending the founder’s approval.
    </p>
  </PageHeader>

  <nav class="wrap dialogue-nav" aria-label="On this page">
    <ol role="list">
      <li><a href="#contributions">Research contributions</a></li>
      <li><a href="#collaborations">Academic collaborations</a></li>
      <li><a href="#lectures">Lectures and seminars</a></li>
      <li><a href="#calls">Calls for papers</a></li>
      <li><a href="#events">Workshops and events</a></li>
    </ol>
  </nav>

  <section class="section" id="contributions" aria-labelledby="contributions-title">
    <div class="wrap">
      <SectionHead index="01" label="Research contributions" />
      <div class="grid">
        <h2 class="col-title" id="contributions-title">Contributing to the archive.</h2>
        <div class="col-body prose">
          <p>
            The archive welcomes proposals for research, case studies, critical responses and documentation of projects that apply,
            extend or question the approach. Proposals are reviewed by the editors. Material is published with full attribution and
            sources, and only with its authors’ permission.
          </p>
          <Provenance kind="proposed" approval="pending" />
          <p><a class="arrow-link" href={url('/contact/#research-contributions')}>Propose a contribution <span class="arrow" aria-hidden="true">→</span></a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="collaborations" aria-labelledby="collaborations-title">
    <div class="wrap">
      <SectionHead index="02" label="Academic collaborations" />
      <div class="grid">
        <h2 class="col-title" id="collaborations-title">Studios, theses and joint research.</h2>
        <div class="col-body prose">
          <p>
            Much of the documented work on New Contextualism has come from design and thesis studios; the founder’s 2025 biography
            refers to numerous undergraduate thesis studios on the philosophy at BRAC University
            (<a href={`#ref-${STUDIO}`}>{cite.label(STUDIO)}</a>). Institutions, teachers and researchers who wish to test the
            framework in their own contexts are invited to write to the editors.
          </p>
          <Provenance kind="proposed" approval="pending" />
          <p><a class="arrow-link" href={url('/contact/#academic-collaborations')}>Discuss a collaboration <span class="arrow" aria-hidden="true">→</span></a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="lectures" aria-labelledby="lectures-title">
    <div class="wrap">
      <SectionHead index="03" label="Lectures and seminars" />
      <div class="grid">
        <h2 class="col-title" id="lectures-title">Talks on New Contextualism.</h2>
        <div class="col-body">
          <p class="pending">
            <span class="label">Forthcoming</span>
            No lectures or seminars are currently scheduled. When they are, they will be listed here with dates and details.
          </p>
        </div>
      </div>
      <div class="lectures">
        <p class="label">Lectures in the archive</p>
        <RecordList reg={reg} records={lectures} compact />
      </div>
    </div>
  </section>

  <section class="section" id="calls" aria-labelledby="calls-title">
    <div class="wrap">
      <SectionHead index="04" label="Calls for papers" />
      <div class="grid">
        <h2 class="col-title" id="calls-title">Open calls.</h2>
        <div class="col-body">
          {
            calls.length ? (
              <ul role="list" class="calls">
                {calls.map((c) => (
                  <li>
                    <a href={`#${c.id}`}>{c.data.title}</a>
                    {c.data.deadline && <span class="muted"> · Deadline {formatDate(c.data.deadline)}</span>}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="pending">
                <span class="label">None open</span>
                There are no open calls for papers at present. Calls will be published here with their deadlines and submission
                requirements.
              </p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="events" aria-labelledby="events-title">
    <div class="wrap">
      <SectionHead index="05" label="Workshops and events" />
      <div class="grid">
        <h2 class="col-title" id="events-title">Workshops, symposia and events.</h2>
        <div class="col-body">
          {
            gatherings.length === 0 && (
              <p class="pending">
                <span class="label">Forthcoming</span>
                No events are currently scheduled.
              </p>
            )
          }
        </div>
      </div>

      {
        [...gatherings, ...past].map((e) => (
          <article class="event" id={e.id} aria-labelledby={`${e.id}-title`} data-reveal>
            <div class="event__when">
              <p class="event__date">{when(e)}</p>
              <p class="label">{eventIsUpcoming(e) ? 'Forthcoming' : 'Past event'}</p>
            </div>
            <div class="event__body">
              <p class="label">
                {EVENT_TYPE_LABELS[e.data.type]} · {FORMAT[e.data.format]}
              </p>
              <h3 class="event__title" id={`${e.id}-title`}>
                {e.data.title}
              </h3>
              <p class="event__summary">{e.data.summary}</p>
              <dl class="facts event__facts">
                {e.data.location && (
                  <>
                    <dt class="label">Where</dt>
                    <dd>{e.data.location}</dd>
                  </>
                )}
                {e.data.time && (
                  <>
                    <dt class="label">Time</dt>
                    <dd>{e.data.time}</dd>
                  </>
                )}
                {e.data.organiser && (
                  <>
                    <dt class="label">Organiser</dt>
                    <dd>{e.data.organiser}</dd>
                  </>
                )}
                {e.data.programme.length > 0 && (
                  <>
                    <dt class="label">Programme</dt>
                    <dd>
                      <ol role="list" class="programme">
                        {e.data.programme.map((item) => (
                          <li>
                            {item.record ? <a href={url(`/research/${item.record}/`)}>{item.title}</a> : item.title}
                            {item.speaker && <span class="muted"> · {item.speaker}</span>}
                          </li>
                        ))}
                      </ol>
                    </dd>
                  </>
                )}
                {e.data.participants.length > 0 && (
                  <>
                    <dt class="label">{e.data.type === 'symposium' ? 'Speakers' : 'Facilitators'}</dt>
                    <dd>
                      <ul role="list" class="programme">
                        {e.data.participants.map((pt) => (
                          <li>
                            {pt.name}
                            {pt.role && e.data.type === 'symposium' && <span class="muted"> · {pt.role}</span>}
                          </li>
                        ))}
                      </ul>
                    </dd>
                  </>
                )}
                {e.data.registration && eventIsUpcoming(e) && (
                  <>
                    <dt class="label">Registration</dt>
                    <dd>
                      <a class="ext" href={e.data.registration}>
                        Register
                      </a>
                    </dd>
                  </>
                )}
                <dt class="label">Sources</dt>
                <dd>
                  {e.data.sources.map((k, i) => (
                    <>{i > 0 && '; '}<a href={`#ref-${k}`}>{cite.label(k)}</a></>
                  ))}
                </dd>
              </dl>
              {rendered.get(e.id) && <div class="prose event__desc" set:html={rendered.get(e.id)} />}
              <Provenance kind={e.data.provenance} />
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <div class="section">
    <div class="wrap">
      <Bibliography reg={reg} keys={cite.cited()} />
    </div>
  </div>
</Base>

<style>
  .dialogue-nav ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 0;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
  }

  .dialogue-nav a {
    text-decoration-color: var(--rule);
  }

  .col-title {
    grid-column: 1 / span 5;
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 3.75rem);
    line-height: 1.02;
  }

  .col-body {
    grid-column: 7 / span 6;
    display: grid;
    gap: 1.25rem;
    max-width: 40rem;
    align-content: start;
  }

  .lectures {
    display: grid;
    gap: 0.75rem;
    margin-top: 3.5rem;
  }

  .calls {
    margin: 0;
  }

  .event {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 1.5rem var(--col-gap);
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .event__date {
    font-family: var(--serif);
    font-size: clamp(1.75rem, 1.3rem + 1.5vw, 2.75rem);
    line-height: 1.05;
    margin-bottom: 0.5rem;
  }

  .event__body {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }

  .event__title {
    font-size: var(--fs-h3);
  }

  .event__summary {
    font-size: 1.0625rem;
  }

  .event__facts {
    margin-top: 0.5rem;
  }

  .programme {
    margin: 0;
  }

  .programme li + li {
    margin-top: 0.35rem;
  }

  .event__desc {
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .col-title,
    .col-body {
      grid-column: 1 / -1;
    }

    .col-body {
      margin-top: 1.75rem;
    }

    .event {
      grid-template-columns: 1fr;
    }
  }
</style>
