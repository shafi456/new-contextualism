---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import Provenance from '../components/Provenance.astro';
import Bibliography from '../components/Bibliography.astro';
import { citations, founder, listed, registry } from '../lib/content';
import { displayName } from '../lib/format';
import { pubYear } from '../lib/cite';
import { EVENT_TYPE_LABELS, PROVENANCE, PROVENANCE_META } from '../lib/provenance';
import { url } from '../lib/url';

const reg = await registry();
const cite = citations(reg, 'about');
const platform = await getEntry('pages', 'platform');
const platformHtml = cite.md(platform?.body);
const person = founder(reg)!;
const p = person.data;
const bio = cite.md(person.body);
const ref = (k: string) => {
  cite.add(k);
  return cite.label(k);
};
[...p.appointments, ...p.education, ...p.affiliations, ...p.presentations].forEach((x) => cite.add(x.source));
const scholarship = reg.publications.filter((x) => x.data.collection === 'founder' && !x.data.archived);
const ncWritings = reg.publications.filter(
  (x) => x.data.collection === 'new-contextualism' && x.data.authors.includes('Reza, Mohammad Habib') && x.data.type !== 'lecture',
);

// Contributors to the public record, compiled from records, projects and events.
const FOUNDER = 'Mohammad Habib Reza';
type Contribution = { text: string; href: string };
const people = new Map<string, Contribution[]>();
const add = (name: string, c: Contribution) => {
  if (name === FOUNDER) return;
  people.set(name, [...(people.get(name) ?? []), c]);
};
for (const pub of listed(reg.publications)) {
  if (pub.data.collection !== 'new-contextualism') continue;
  for (const a of pub.data.authors) {
    if (!a.includes(',')) continue;
    const role = pub.data.type === 'lecture' ? 'Lecture' : pub.data.authors.length > 1 ? 'Co-author' : 'Author';
    add(displayName(a), { text: `${role}: ‘${pub.data.title}’ (${pubYear(pub)})`, href: url(`/research/${pub.id}/`) });
  }
}
for (const proj of listed(reg.projects)) {
  for (const t of proj.data.team) {
    add(t.name, { text: `${t.role ?? 'Team member'}: ‘${proj.data.title}’`, href: url(`/projects/${proj.id}/`) });
  }
}
for (const ev of reg.events) {
  for (const part of ev.data.participants) {
    const role = ev.data.type === 'symposium' ? 'Speaker' : (part.role ?? 'Participant');
    add(part.name, {
      text: `${role}, ${EVENT_TYPE_LABELS[ev.data.type].toLowerCase()} (${ev.data.start.getUTCFullYear()})`,
      href: url(`/dialogue/#${ev.id}`),
    });
  }
}
const contributors = [...people.entries()].sort((a, b) => {
  const fa = a[0].split(' ').pop() ?? a[0];
  const fb = b[0].split(' ').pop() ?? b[0];
  return fa.localeCompare(fb);
});
---

<Base
  title="About"
  description="About the New Contextualism platform, its founder Mohammad Habib Reza, the contributors to its public record and its editorial governance."
>
  <PageHeader label="About" title="About" intro={platform?.data.intro} />

  <section class="section about-platform" id="platform" aria-labelledby="platform-title">
    <div class="wrap">
      <SectionHead index="01" label="The platform" />
      <div class="grid">
        <h2 class="col-title" id="platform-title">An archive as much as a publication.</h2>
        <div class="col-body">
          <div class="prose" set:html={platformHtml} />
          <Provenance kind={platform?.data.provenance ?? 'proposed'} approval={platform?.data.approval} />
        </div>
      </div>
    </div>
  </section>

  <section class="section founder" id="founder" aria-labelledby="founder-title">
    <div class="wrap">
      <SectionHead index="02" label="The founder" />
      <div class="grid">
        <div class="founder__portrait">
          {
            p.portrait ? (
              <figure>
                <Image src={p.portrait.src} alt={p.portrait.alt} widths={[400, 800, 1200]} sizes="(min-width: 1080px) 30vw, 100vw" />
                <figcaption class="small muted">{p.portrait.credit}</figcaption>
              </figure>
            ) : (
              <div class="portrait-slot" role="img" aria-label="Placeholder: an approved portrait of the founder has not yet been supplied">
                <span class="label">Portrait</span>
                <span class="portrait-slot__note">An approved photograph of the founder will appear here.</span>
              </div>
            )
          }
        </div>
        <div class="founder__main">
          <p class="label">{p.role}</p>
          <h2 class="founder__name" id="founder-title">{p.name}</h2>
          <Provenance kind={p.provenance} approval={p.approval} note="Compiled from published sources" />
          <div class="prose founder__bio" set:html={bio} />

          <div class="founder__facts">
            <div class="fact-group">
              <h3 class="label">Appointments</h3>
              <ul role="list">
                {
                  p.appointments.map((a) => (
                    <li>
                      <span class="fact-group__main">
                        {a.title}, {a.organisation}
                      </span>
                      <span class="fact-group__meta">
                        {a.period && `${a.period} · `}
                        <a href={`#ref-${a.source}`}>{ref(a.source)}</a>
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="fact-group">
              <h3 class="label">Education</h3>
              <ul role="list">
                {
                  p.education.map((e) => (
                    <li>
                      <span class="fact-group__main">
                        {e.degree}, {e.institution}
                      </span>
                      <span class="fact-group__meta">
                        {e.year && `${e.year} · `}
                        <a href={`#ref-${e.source}`}>{ref(e.source)}</a>
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="fact-group">
              <h3 class="label">Affiliations, as stated in published biographies</h3>
              <ul role="list">
                {
                  p.affiliations.map((a) => (
                    <li>
                      <span class="fact-group__main">{a.title}</span>
                      <span class="fact-group__meta">
                        <a href={`#ref-${a.source}`}>{ref(a.source)}</a>
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="fact-group">
              <h3 class="label">Selected lectures and presentations</h3>
              <ul role="list">
                {
                  p.presentations.map((x) => (
                    <li>
                      <span class="fact-group__main">
                        {x.title}<span class="muted">{`, ${x.venue}`}</span>
                      </span>
                      <span class="fact-group__meta">
                        {x.date} · <a href={`#ref-${x.source}`}>{ref(x.source)}</a>
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="fact-group">
              <h3 class="label">Writing on New Contextualism</h3>
              <ul role="list">
                {
                  ncWritings.map((w) => (
                    <li>
                      <a class="fact-group__main" href={url(`/research/${w.id}/`)}>
                        {w.data.title}
                      </a>
                      <span class="fact-group__meta">
                        <i>{w.data.venue}</i>, {pubYear(w)}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="fact-group">
              <h3 class="label">Selected earlier scholarship</h3>
              <ul role="list">
                {
                  scholarship.map((w) => (
                    <li>
                      <a class="fact-group__main" href={url(`/research/${w.id}/`)}>
                        {w.data.title}
                      </a>
                      <span class="fact-group__meta">{pubYear(w)}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="fact-group">
              <h3 class="label">Profiles elsewhere</h3>
              <ul role="list" class="profiles">
                {
                  p.links.map((l) => (
                    <li>
                      <a class="ext" href={l.url}>
                        {l.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section contributors" id="contributors" aria-labelledby="contributors-title">
    <div class="wrap">
      <SectionHead index="03" label="Contributors" />
      <div class="grid">
        <div class="col-title-wrap">
          <h2 class="col-title" id="contributors-title">Contributors to the public record.</h2>
          <p class="small muted contributors__note">
            Compiled automatically from the records, projects and events on this platform. Names are given as they appear in the
            sources. Inclusion records a contribution; it does not imply membership of any organisation.
          </p>
        </div>
        <ol class="contributors__list" role="list">
          {
            contributors.map(([name, items]) => (
              <li>
                <span class="contributors__name">{name}</span>
                <ul role="list">
                  {items.map((c) => (
                    <li>
                      <a href={c.href}>{c.text}</a>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section governance" id="governance" aria-labelledby="governance-title">
    <div class="wrap">
      <SectionHead index="04" label="Editorial governance" />
      <div class="grid">
        <div class="col-title-wrap">
          <h2 class="col-title" id="governance-title">Every text says where it comes from.</h2>
        </div>
        <div class="col-body">
          <p>
            The platform distinguishes verified statements from published sources, editorial summaries, proposed statements,
            founder-approved text and interpretation. Each substantial text carries one of these labels:
          </p>
          <ul class="labels-legend" role="list">
            {
              PROVENANCE.map((k) => (
                <li>
                  <Provenance kind={k} />
                  <span class="small muted">{PROVENANCE_META[k].description}</span>
                </li>
              ))
            }
          </ul>
          <p>
            The statement of the philosophy, the founder’s profile and the platform’s branding require the founder’s approval
            before the platform is formally launched.
          </p>
          <p class="governance__links">
            <a class="arrow-link" href={url('/editorial-standards/')}>Editorial standards <span class="arrow" aria-hidden="true">→</span></a>
            <a class="arrow-link arrow-link--quiet" href={url('/contact/')}>Contact the editors <span class="arrow" aria-hidden="true">→</span></a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="section">
    <div class="wrap">
      <Bibliography reg={reg} keys={cite.cited()} />
    </div>
  </div>
</Base>

<style>
  .col-title,
  .col-title-wrap {
    grid-column: 1 / span 5;
  }

  .col-title {
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 3.75rem);
    line-height: 1.02;
  }

  .col-title-wrap {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .col-title-wrap .col-title {
    grid-column: auto;
  }

  .col-body {
    grid-column: 7 / span 6;
    display: grid;
    gap: 1.5rem;
    max-width: 40rem;
  }

  /* Founder */
  .founder__portrait {
    grid-column: 1 / span 4;
  }

  .founder__portrait figure img {
    width: 100%;
  }

  .portrait-slot {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 4 / 5;
    padding: 1rem;
    border: 1px solid var(--rule);
    background:
      linear-gradient(to top right, transparent calc(50% - 0.5px), var(--rule) 50%, transparent calc(50% + 0.5px)),
      var(--paper);
  }

  .portrait-slot__note {
    max-width: 14rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ink-2);
    background: var(--paper);
  }

  .founder__main {
    grid-column: 6 / span 7;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .founder__name {
    font-size: var(--fs-h2);
  }

  .founder__bio {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
  }

  .founder__bio :global(p:first-child) {
    font-family: var(--serif);
    font-size: clamp(1.3rem, 1.15rem + 0.55vw, 1.6rem);
    line-height: 1.3;
  }

  .founder__facts {
    display: grid;
    gap: 2.25rem;
    margin-top: 2rem;
  }

  .fact-group ul {
    margin: 0.6rem 0 0;
    border-top: 1px solid var(--ink);
  }

  .fact-group li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 1.5rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .fact-group__meta {
    font-size: 0.8125rem;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .fact-group__meta a {
    text-decoration-color: var(--rule);
  }

  a.fact-group__main {
    font-family: var(--serif);
    font-size: 1.1875rem;
    text-decoration-color: var(--rule);
  }

  .profiles {
    display: block;
  }

  /* Contributors */
  .contributors__note {
    max-width: 26rem;
  }

  .contributors__list {
    grid-column: 7 / span 6;
    margin: 0;
    border-top: 1px solid var(--ink);
  }

  .contributors__list > li {
    display: grid;
    grid-template-columns: minmax(10rem, 2fr) 3fr;
    gap: 0.25rem 1.5rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .contributors__name {
    font-family: var(--serif);
    font-size: 1.3125rem;
    line-height: 1.2;
  }

  .contributors__list ul {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .contributors__list ul a {
    text-decoration-color: var(--rule);
  }

  .contributors__list ul li + li {
    margin-top: 0.25rem;
  }

  /* Governance */
  .labels-legend {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }

  .labels-legend li {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }

  .governance__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  @media (max-width: 1080px) {
    .col-title,
    .col-title-wrap,
    .col-body,
    .founder__main,
    .contributors__list {
      grid-column: 1 / -1;
    }

    .col-body,
    .contributors__list {
      margin-top: 2rem;
    }

    .founder__portrait {
      grid-column: 1 / span 6;
      margin-bottom: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .founder__portrait {
      grid-column: 1 / -1;
    }

    .fact-group li,
    .contributors__list > li,
    .labels-legend li {
      grid-template-columns: 1fr;
    }

    .fact-group__meta {
      white-space: normal;
    }
  }
</style>
