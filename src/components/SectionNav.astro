---
/**
 * The pages of a section, as a sticky contents list beside the text (on wide
 * screens), a strip above full-width pages, and a disclosure on small
 * screens. The current page lists its sub-items, or its child pages.
 */
import type { IaSection } from '../lib/ia';
import { url } from '../lib/url';

interface Props {
  section: IaSection;
  current: string;
  /** Links listed under the current page: its sub-items or child pages. */
  subnav?: { href: string; label: string; current?: boolean }[];
  variant: 'side' | 'strip' | 'disclosure';
}

const { section, current, subnav = [], variant } = Astro.props;
const items = section.pages.map((p) => ({
  href: url(p.path),
  number: p.number,
  label: p.short ?? p.title,
  current: p.path === current,
}));
---

{
  variant === 'disclosure' ? (
    <details class="snav-disclosure" data-print="hide">
      <summary>
        <span class="label">In this section</span>
        <span class="snav-disclosure__name">
          {section.number ? `${section.number} · ${section.title}` : section.title}
        </span>
      </summary>
      <nav aria-label={`${section.title}, all pages`}>
        <ol class="snav__list" role="list">
          {items.map((p) => (
            <li>
              <a href={p.href} aria-current={p.current ? 'page' : undefined}>
                <span class="snav__num">{p.number}</span>
                <span>{p.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  ) : variant === 'strip' ? (
    <nav class="snav-strip" aria-label={`${section.title}, pages`} data-print="hide">
      <p class="label snav__title">
        <a href={url(section.path)}>
          {section.number && <span class="index">{section.number}</span>}
          {section.number && <span class="sep" aria-hidden="true">/</span>}
          <span>{section.title}</span>
        </a>
      </p>
      <ol role="list">
        {items.map((p) => (
          <li>
            <a href={p.href} aria-current={p.current ? 'page' : undefined}>
              <span class="snav__num">{p.number}</span>{' '}{p.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  ) : (
    <nav class="snav" aria-label={`${section.title}, pages`} data-print="hide">
      <p class="label snav__title">
        <a href={url(section.path)}>
          {section.number && <span class="index">{section.number}</span>}
          {section.number && <span class="sep" aria-hidden="true">/</span>}
          <span>{section.title}</span>
        </a>
      </p>
      <ol class="snav__list" role="list">
        {items.map((p) => (
          <li>
            <a href={p.href} aria-current={p.current ? 'page' : undefined}>
              <span class="snav__num">{p.number}</span>
              <span>{p.label}</span>
            </a>
            {p.current && subnav.length > 0 && (
              <ol class="snav__children" role="list">
                {subnav.map((c) => (
                  <li>
                    <a href={c.href} aria-current={c.current ? 'page' : undefined} data-snav-item={c.href.startsWith('#') ? c.href.slice(1) : undefined}>
                      {c.label}
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .snav__title a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6em;
    color: inherit;
    text-decoration: none;
  }

  .snav__title .index {
    color: var(--ink);
  }

  .snav__title .sep {
    color: var(--grey);
  }

  .snav__list {
    margin: 0.75rem 0 0;
    border-top: 1px solid var(--rule);
  }

  .snav__list > li > a {
    display: flex;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.875rem;
    line-height: 1.4;
    text-decoration: none;
    color: var(--ink-2);
    transition: color 0.25s var(--ease);
  }

  .snav__list a:hover,
  .snav__list a[aria-current] {
    color: var(--ink);
  }

  .snav__num {
    flex: none;
    min-width: 2.1rem;
    padding-top: 0.12em;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .snav__list a[aria-current] .snav__num {
    color: var(--brick);
  }

  .snav__children {
    margin: 0;
    padding: 0.35rem 0 0.6rem 2.85rem;
    border-bottom: 1px solid var(--rule);
  }

  .snav__children a {
    display: block;
    padding: 0.2rem 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-2);
    text-decoration: none;
  }

  .snav__children a:hover,
  .snav__children a[aria-current] {
    color: var(--ink);
  }

  .snav__children a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--brick);
  }

  /* Strip, above full-width pages */
  .snav-strip {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .snav-strip ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    margin: 0;
  }

  .snav-strip a {
    font-size: 0.875rem;
    color: var(--ink-2);
    text-decoration: none;
  }

  .snav-strip a:hover,
  .snav-strip a[aria-current] {
    color: var(--ink);
  }

  .snav-strip a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--brick);
    text-underline-offset: 0.3em;
  }

  .snav-strip a[aria-current] .snav__num {
    color: var(--brick);
  }

  /* Disclosure, on small screens */
  .snav-disclosure {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  .snav-disclosure summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    cursor: pointer;
    list-style: none;
  }

  .snav-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .snav-disclosure summary::after {
    content: '+';
    font-size: 1.25rem;
    line-height: 1;
    color: var(--ink-2);
  }

  .snav-disclosure[open] summary::after {
    content: '–';
  }

  .snav-disclosure__name {
    margin-right: auto;
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .snav-disclosure .snav__list {
    margin: 0 0 0.75rem;
  }
</style>
