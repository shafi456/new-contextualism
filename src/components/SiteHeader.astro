---
import { NAV, UTILITY_LINKS, settings } from '../lib/site';
import { to } from '../lib/routes';
import { url } from '../lib/url';

const secondary = [...UTILITY_LINKS.filter((l) => !l.href.endsWith('/search/')), { href: to.contact(), label: 'Contact' }];

const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : path.startsWith(href) ? 'true' : undefined);
---

<header class="site-header" data-header>
  <div class="wrap site-header__inner">
    <a class="wordmark" href={url('/')} aria-label={`${settings.title}, home`}>New Contextualism</a>

    <nav class="primary-nav" aria-label="Primary">
      <ul role="list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__tools">
      <a class="icon-button" href={url('/search/')} data-search-open aria-label="Search" title="Search (press /)">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3">
          <circle cx="7.5" cy="7.5" r="5.75"></circle>
          <path d="M11.8 11.8 16.5 16.5"></path>
        </svg>
      </a>
      <button class="menu-button" type="button" data-menu-open aria-haspopup="dialog" aria-controls="site-menu">
        Menu
      </button>
    </div>
  </div>
</header>

<dialog class="site-menu" id="site-menu" aria-label="Menu" data-menu>
  <div class="wrap site-menu__inner">
    <div class="site-menu__bar">
      <a class="wordmark" href={url('/')}>New Contextualism</a>
      <button class="menu-button" type="button" data-menu-close>Close</button>
    </div>
    <nav aria-label="Primary (menu)">
      <ol class="site-menu__list" role="list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href)}>
                <span class="site-menu__name">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <ul class="site-menu__secondary" role="list">
      <li><a href={url('/search/')} data-search-open>Search</a></li>
      {
        secondary.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
    <p class="site-menu__line serif">{settings.footerLine}</p>
  </div>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--ease);
  }

  .site-header[data-scrolled] {
    border-bottom-color: var(--rule);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: var(--header-h);
  }

  .wordmark {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    margin-right: auto;
  }

  .primary-nav ul {
    display: flex;
    gap: clamp(1.1rem, 2.1vw, 2.25rem);
    margin: 0;
  }

  .primary-nav a {
    position: relative;
    font-size: 0.875rem;
    text-decoration: none;
    padding-block: 0.4rem;
    white-space: nowrap;
  }

  .primary-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.05rem;
    height: 1px;
    background: var(--brick);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }

  .primary-nav a:hover::after {
    transform: scaleX(1);
  }

  .primary-nav a[aria-current]::after {
    background: var(--ink);
    transform: scaleX(1);
  }

  .site-header__tools {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .icon-button {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-right: -0.5rem;
    color: var(--ink);
    border-radius: 50%;
    transition: color 0.25s var(--ease);
  }

  .icon-button:hover {
    color: var(--brick);
  }

  .menu-button {
    display: none;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--ink);
    padding: 0.2rem 0 0.1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* The full section names need about 1,240px; below that the menu takes over. */
  @media (max-width: 1260px) {
    .primary-nav {
      display: none;
    }

    .menu-button {
      display: inline-block;
    }

    .icon-button {
      margin-right: 0.25rem;
    }
  }

  /* Menu (small screens) */
  .site-menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
  }

  .site-menu::backdrop {
    background: var(--paper);
  }

  .site-menu[open] {
    animation: menu-in 0.35s var(--ease);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }

  .site-menu__inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-bottom: 2rem;
  }

  .site-menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    border-bottom: 1px solid var(--rule);
  }

  .site-menu .menu-button {
    display: inline-block;
  }

  .site-menu__list {
    margin: 1.5rem 0 0;
  }

  .site-menu__list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .site-menu__name {
    font-family: var(--serif);
    font-size: clamp(2rem, 8vw, 3rem);
    line-height: 1.05;
  }

  .site-menu__list a[aria-current] .site-menu__name {
    font-style: italic;
  }

  .site-menu__secondary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 2rem 0 0;
    font-size: var(--fs-small);
  }

  .site-menu__line {
    margin-top: auto;
    padding-top: 3rem;
    font-size: 1.5rem;
    color: var(--ink-2);
  }
</style>
