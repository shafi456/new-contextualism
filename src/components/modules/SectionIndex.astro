---
/** The pages of a section, with their numbers and summaries. */
import { UTILITY_SECTION, locate, sectionByKey, type IaSection } from '../../lib/ia';
import { url } from '../../lib/url';

interface Props {
  path: string;
  attrs: { section?: string };
}

const { path, attrs } = Astro.props;
const section: IaSection | undefined = attrs.section
  ? attrs.section === 'utilities'
    ? UTILITY_SECTION
    : sectionByKey(attrs.section as IaSection['key'])
  : locate(path).section;
if (!section) throw new Error(`section-index on ${path}: no section`);
const pages = section.pages.filter((p) => p.path !== path);
---

<ol class="sindex" role="list">
  {
    pages.map((p) => (
      <li data-reveal>
        <a href={url(p.path)}>
          <span class="sindex__num">{p.number}</span>
          <span class="sindex__name">{p.title}</span>
          <span class="sindex__summary">{p.summary}</span>
          <span class="sindex__arrow" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .sindex {
    margin: 0;
    border-top: 1px solid var(--ink);
  }

  .sindex a {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 5fr) minmax(0, 4fr) 2rem;
    gap: 0.5rem var(--col-gap);
    align-items: baseline;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .sindex__num {
    font-size: 0.75rem;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .sindex__name {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 1.15rem + 0.9vw, 2rem);
    line-height: 1.1;
    transition: color 0.3s var(--ease);
  }

  .sindex__summary {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .sindex__arrow {
    justify-self: end;
    transition: transform 0.3s var(--ease);
  }

  .sindex a:hover .sindex__name {
    color: var(--brick);
  }

  .sindex a:hover .sindex__arrow {
    transform: translateX(4px);
  }

  @media (max-width: 720px) {
    .sindex a {
      grid-template-columns: 2.75rem minmax(0, 1fr) 1.5rem;
    }

    .sindex__summary {
      grid-column: 2;
    }

    .sindex__arrow {
      grid-row: 1;
      grid-column: 3;
    }
  }
</style>
