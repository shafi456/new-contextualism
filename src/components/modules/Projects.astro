---
/**
 * Project modules: a grid of project cards selected by flag, category or
 * status, and the legend of statuses and categories with their counts.
 */
import type { Registry } from '../../lib/content';
import { listed, projectsWhere } from '../../lib/content';
import { CATEGORY_LABELS, STATUS_DESCRIPTIONS, STATUS_LABELS } from '../../lib/provenance';
import { pad } from '../../lib/format';
import { to } from '../../lib/routes';
import ProjectCard from '../ProjectCard.astro';

interface Props {
  name: 'projects' | 'project-legend';
  reg: Registry;
  attrs: { filter?: string; category?: string; status?: string; empty?: string };
}

const { name, reg, attrs } = Astro.props;
const items = name === 'projects' ? projectsWhere(reg, attrs) : [];
const all = listed(reg.projects);
const statuses = (['completed', 'ongoing', 'conceptual'] as const).map((s) => ({
  status: s,
  n: all.filter((p) => p.data.status === s).length,
}));
const categories = Object.entries(CATEGORY_LABELS).map(([key, label]) => ({
  key,
  label,
  n: all.filter((p) => (p.data.categories as string[]).includes(key)).length,
}));
---

{
  name === 'projects' &&
    (items.length ? (
      <div class="grid project-grid">
        {items.map((p, i) => (
          <div class:list={['project-grid__item', { 'project-grid__item--offset': i % 2 === 1 }]} data-reveal>
            <ProjectCard project={p} dimensions={reg.dimensions} headingLevel={3} sizes="(min-width: 900px) 40vw, 100vw" />
          </div>
        ))}
      </div>
    ) : (
      <p class="pending project-empty">
        <span class="label">None documented</span>
        {attrs.empty ?? 'No projects in this category have yet been documented on this platform.'}
      </p>
    ))
}

{
  name === 'project-legend' && (
    <div class="project-legend">
      <div class="project-legend__col">
        <p class="label">Status</p>
        <dl class="legend">
          {statuses.map((g) => (
            <div class="legend__row">
              <dt>
                <a class={`status status--${g.status}`} href={to.projects({ status: g.status })}>
                  {STATUS_LABELS[g.status]}
                </a>
              </dt>
              <dd class="legend__desc">{STATUS_DESCRIPTIONS[g.status]}</dd>
              <dd class="legend__n num">{pad(g.n)}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="project-legend__col">
        <p class="label">Classification</p>
        <dl class="legend">
          {categories.map((c) => (
            <div class="legend__row legend__row--short">
              <dt>
                <a href={to.projects({ category: c.key })}>{c.label}</a>
              </dt>
              <dd class="legend__n num">{pad(c.n)}</dd>
            </div>
          ))}
        </dl>
        <p class="small muted project-legend__note">
          The classification is editorial. A project may belong to more than one category.
        </p>
      </div>
      <p class="notice">
        <span class="label">About the images</span>
        The drawings that accompany these projects are abstract editorial plates made for this platform. They are not drawings of
        the projects. Photographs and drawings of each project will be added only with the permission of its authors.
      </p>
    </div>
  )
}

<style>
  .project-grid {
    row-gap: clamp(3.5rem, 2.5rem + 3vw, 6rem);
  }

  .project-grid__item {
    grid-column: span 6;
  }

  .project-grid__item--offset {
    padding-top: clamp(0rem, 6vw, 6rem);
  }

  .project-empty {
    max-width: 44rem;
  }

  .project-legend {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem var(--col-gap);
  }

  .legend {
    margin: 0.6rem 0 0;
    border-top: 1px solid var(--ink);
  }

  .legend__row {
    display: grid;
    grid-template-columns: 13rem 1fr 3rem;
    gap: 1rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.875rem;
  }

  .legend__row--short {
    grid-template-columns: 1fr 3rem;
  }

  .legend a {
    text-decoration-color: var(--rule);
  }

  .legend__desc {
    color: var(--ink-2);
  }

  .legend__n {
    justify-self: end;
    font-family: var(--serif);
    font-size: 1.5rem;
    line-height: 1;
  }

  .project-legend__note {
    margin-top: 0.75rem;
  }

  .notice {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.4rem;
    max-width: 52rem;
    padding: 1rem 0 0;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .project-grid__item {
      grid-column: 1 / -1;
    }

    .project-grid__item--offset {
      padding-top: 0;
    }

    .project-legend {
      grid-template-columns: 1fr;
    }

    .legend__row {
      grid-template-columns: 1fr 3rem;
    }

    .legend__desc {
      grid-column: 1;
      grid-row: 2;
    }

    .legend__n {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>
