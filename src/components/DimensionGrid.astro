---
/**
 * The ten dimensions as a typographic grid. Hovering or focusing one traces
 * its relations to the others (an editorial interpretation); each cell links
 * to the dimension's page.
 */
import type { Dimension } from '../lib/content';
import { relationsFor } from '../lib/content';
import { pad } from '../lib/format';
import { url } from '../lib/url';

interface Props {
  dimensions: Dimension[];
}

const { dimensions } = Astro.props;
const names = Object.fromEntries(dimensions.map((d) => [d.id, d.data.name]));
---

<div class="dim-grid-wrap" data-dim-grid>
  <ol class="dim-grid" role="list">
    {
      dimensions.map((d) => {
        const related = relationsFor(d.id).map((r) => r.other);
        return (
          <li class="dim-cell" data-dim={d.id} data-related={related.join(' ')}>
            <span class="dim-cell__mark" aria-hidden="true" />
            <a class="dim-cell__link" href={url(`/framework/${d.id}/`)} aria-describedby={`dim-rel-${d.id}`}>
              <span class="dim-cell__num">{pad(d.data.number)}</span>
              <span class="dim-cell__name">{d.data.name}</span>
              <span class="dim-cell__keys">{d.data.keywords.join(', ')}</span>
            </a>
            <span class="visually-hidden" id={`dim-rel-${d.id}`}>
              Related most directly to {related.map((r) => names[r]).join(', ')}.
            </span>
          </li>
        );
      })
    }
  </ol>
  <p class="dim-readout" aria-hidden="true">
    <span class="label">Relations</span>
    <span class="dim-readout__text" data-dim-readout>Hover over or focus on a dimension to trace its relations.</span>
  </p>
</div>

<style>
  .dim-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--ink);
  }

  .dim-cell {
    position: relative;
    border-bottom: 1px solid var(--rule);
    border-right: 1px solid var(--rule);
    transition: opacity 0.45s var(--ease);
  }

  .dim-cell:nth-child(5n) {
    border-right: 0;
  }

  .dim-cell__mark {
    position: absolute;
    left: 0;
    top: -1px;
    height: 2px;
    width: 0;
    background: var(--brick);
    transition:
      width 0.5s var(--ease),
      background-color 0.3s var(--ease);
  }

  .dim-cell__link {
    display: flex;
    flex-direction: column;
    min-height: clamp(10.5rem, 6rem + 9vw, 16rem);
    padding: 1rem 1.1rem 1.3rem;
    text-decoration: none;
  }

  .dim-cell__num {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .dim-cell__name {
    margin-top: auto;
    font-family: var(--serif);
    font-size: clamp(1.65rem, 1.1rem + 1.35vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
    transition: color 0.3s var(--ease);
  }

  .dim-cell__keys {
    /* Two lines reserved, so names share a baseline across the row. */
    min-height: calc(2 * 1.4em);
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .dim-cell.is-muted {
    opacity: 0.26;
  }

  .dim-cell.is-active .dim-cell__mark {
    width: 100%;
  }

  .dim-cell.is-active .dim-cell__name {
    color: var(--brick);
  }

  .dim-cell.is-related .dim-cell__mark {
    width: 2.25rem;
    background: var(--ink);
  }

  .dim-readout {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    align-items: baseline;
    min-height: 3.25rem;
    padding-top: 1rem;
    font-size: 0.9375rem;
  }

  .dim-readout__text :global(strong) {
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .dim-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dim-cell:nth-child(5n) {
      border-right: 1px solid var(--rule);
    }

    .dim-cell:nth-child(2n) {
      border-right: 0;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-dim-grid]').forEach((root) => {
    const cells = [...root.querySelectorAll<HTMLElement>('[data-dim]')];
    const readout = root.querySelector<HTMLElement>('[data-dim-readout]');
    if (!readout) return;
    const initial = readout.textContent ?? '';
    const name = (id: string) => root.querySelector(`[data-dim="${id}"] .dim-cell__name`)?.textContent ?? id;

    const activate = (cell: HTMLElement) => {
      const id = cell.dataset.dim ?? '';
      const related = (cell.dataset.related ?? '').split(' ').filter(Boolean);
      cells.forEach((c) => {
        const cid = c.dataset.dim ?? '';
        c.classList.toggle('is-active', c === cell);
        c.classList.toggle('is-related', related.includes(cid));
        c.classList.toggle('is-muted', c !== cell && !related.includes(cid));
      });
      const strong = document.createElement('strong');
      strong.textContent = name(id);
      readout.replaceChildren(strong, ` relates most directly to ${related.map(name).join(', ')}.`);
    };

    const reset = () => {
      cells.forEach((c) => c.classList.remove('is-active', 'is-related', 'is-muted'));
      readout.textContent = initial;
    };

    cells.forEach((c) => {
      c.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType === 'mouse') activate(c);
      });
      c.addEventListener('focusin', () => activate(c));
    });
    root.addEventListener('pointerleave', reset);
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) reset();
    });
  });
</script>
